+/*
+====================
+idAnimManager::RegisterMemoryAnim
+
+Pre-insert an in-memory idMD5Anim built from a glTF clip under its synthetic
+".md5anim" key, so a later GetAnim(key) (e.g. from idDeclModelDef::ParseAnim) is a
+CACHE HIT and never file-loads. Sibling of GetAnim; RENDER calls this once per clip
+after parsing a GLB. The shipped combat wire (animNum -> CycleAnim -> idAnim ->
+idMD5Anim) then resolves the glTF anim with no wire/idAnim/idAnimator change.
+====================
+*/
+idMD5Anim *idAnimManager::RegisterMemoryAnim( const gltfAnimClip_t &clip ) {
+	idMD5Anim **animptrptr = NULL;
+
+	// idempotent: if already registered (or a real file of that name was loaded), reuse it.
+	if ( animations.Get( clip.name, &animptrptr ) ) {
+		return animptrptr ? *animptrptr : NULL;
+	}
+
+	idMD5Anim *anim = new idMD5Anim();
+	if ( !anim->BuildFromGLTF( clip ) ) {
+		gameLocal.Warning( "Couldn't build in-memory anim: '%s'", clip.name.c_str() );
+		delete anim;
+		anim = NULL;
+	}
+	animations.Set( clip.name, anim );
+
+	return anim;
+}
+
+/*
+====================
+D3_RegisterGltfAnim
+
+Free shim declared by RENDER in renderer/Model.h (so neo/renderer never needs an
+anim header / the animationLib global). RENDER's GLB loader calls this once per
+clip; it routes to the manager. Defined here where animationLib lives (linked into
+the monolithic HARDLINK_GAME build).
+====================
+*/
+idMD5Anim *D3_RegisterGltfAnim( const gltfAnimClip_t &clip ) {
+	return animationLib.RegisterMemoryAnim( clip );
+}
