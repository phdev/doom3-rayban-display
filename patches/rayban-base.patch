+extern idCVar aas_binaryCache;
+
 idAASFile *idAASFileManagerLocal::LoadAAS( const char *fileName, unsigned int mapFileCRC ) {
 	idAASFileLocal *file = new idAASFileLocal();
+
+	// Boot-speed: prefer the binary .baas48 cache (skips the idLexer ASCII parse
+	// of the multi-MB .aas48 — same lever as the .bcm/.bmap/.bproc bakes).
+	idStr binaryName = fileName;
+	binaryName.SetFileExtension( "baas48" );
+	if ( aas_binaryCache.GetBool() && file->LoadBinary( binaryName, mapFileCRC ) ) {
+		return file;
+	}
+
 	if ( !file->Load( fileName, mapFileCRC ) ) {
 		delete file;
 		return NULL;
 	}
+
+	// Write the binary cache so the bake / next boot can skip the ASCII parse.
+	// (Verified bit-identical to the ASCII load via a round-trip ASCII-dump diff.)
+	if ( aas_binaryCache.GetBool() ) {
+		file->WriteBinary( binaryName, mapFileCRC );
+	}
+
 	return file;
 }
 
