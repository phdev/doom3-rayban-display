+/*
+============
+idMapFile::WriteBinaryMapFile / LoadBinaryMapFile — binary entities-only cache
+============
+*/
+#define BMAP_MAGIC		(('B'<<0)|('M'<<8)|('A'<<16)|('P'<<24))
+#define BMAP_VERSION	1
+
+void idMapFile::WriteBinaryMapFile( const char * ) const {
+	// Derive the path from the (already once-stripped) map name so it matches
+	// the .bcm/.bproc convention — e.g. "maps/game/enpro.bmap", not
+	// "...enpro.map.bmap" (this map's name carries a .map suffix and the game
+	// calls Parse(name + ".map"), giving a doubled extension on the raw arg).
+	idStr qpath = name;
+	qpath.SetFileExtension( "bmap" );
+	idFile *fp = idLib::fileSystem->OpenFileWrite( qpath, "fs_devpath" );
+	if ( !fp ) {
+		return;
+	}
+	fp->WriteInt( BMAP_MAGIC );
+	fp->WriteInt( BMAP_VERSION );
+	fp->WriteFloat( version );
+	fp->WriteInt( (int)geometryCRC );
+	fp->WriteInt( entities.Num() );
+	for ( int i = 0; i < entities.Num(); i++ ) {
+		entities[i]->epairs.WriteToFileHandle( fp );
+	}
+	idLib::fileSystem->CloseFile( fp );
+	idLib::common->Printf( "wrote binary map cache %s\n", qpath.c_str() );
+}
+
+bool idMapFile::LoadBinaryMapFile( const char *filename ) {
+	// Match WriteBinaryMapFile's path: strip the arg once (= GetName()) then set
+	// the extension, so "maps/game/enpro.map.map" -> "maps/game/enpro.bmap".
+	idStr qpath = filename;
+	qpath.StripFileExtension();
+	qpath.SetFileExtension( "bmap" );
+	idFile *fp = idLib::fileSystem->OpenFileRead( qpath );
+	if ( !fp ) {
+		return false;
+	}
+	int magic = 0, ver = 0, n = 0, crc = 0;
+	float v = 0.0f;
+	fp->ReadInt( magic );
+	fp->ReadInt( ver );
+	if ( magic != BMAP_MAGIC || ver != BMAP_VERSION ) {
+		idLib::fileSystem->CloseFile( fp );
+		return false;
+	}
+	fp->ReadFloat( v );
+	fp->ReadInt( crc );
+	fp->ReadInt( n );
+	if ( n < 0 || n > 1000000 ) {
+		idLib::fileSystem->CloseFile( fp );
+		return false;
+	}
+	name = filename;
+	name.StripFileExtension();
+	version = v;
+	geometryCRC = (unsigned int)crc;
+	fileTime = 0;
+	{ idStr mapName = name; mapName.SetFileExtension( "map" ); idLib::fileSystem->ReadFile( mapName, NULL, &fileTime ); }
+	entities.DeleteContents( true );
+	for ( int i = 0; i < n; i++ ) {
+		idMapEntity *ent = new idMapEntity();
+		ent->epairs.ReadFromFileHandle( fp );
+		entities.Append( ent );
+	}
+	idLib::fileSystem->CloseFile( fp );
+	hasPrimitiveData = false;   // entities-only: brush/patch primitives were skipped
 	return true;
 }
 
