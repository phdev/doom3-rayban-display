diff --git a/neo/framework/d3_arco.cpp b/neo/framework/d3_arco.cpp
new file mode 100644
index 0000000..2c2ac24
--- /dev/null
+++ b/neo/framework/d3_arco.cpp
@@ -0,0 +1,76 @@
+// B1 (Arco) render-state bridge.
+//
+// Feeds dhewm3's idRenderWorld from Arco's authoritative server, run as a PURE
+// renderer (idGameLocal tic never runs). This file is the ONLY Arco FFI surface.
+//
+// HARD INVARIANT (enforced in review): no write to usercmd_t, no
+// cmdSystem->BufferCommandText of gameplay/impulse commands, no idGameLocal /
+// game-> access. Pure render-state setters only. (Replaces the doom3-rayban
+// wearable bridge d3_wearable.cpp, which writes BUTTON_ATTACK/usercmd and is
+// out of scope for Arco — CLAUDE.md #1.)
+
+#include <string.h>
+#include "sys/platform.h"
+#include "idlib/math/Vector.h"
+#include "idlib/math/Angles.h"
+#include "idlib/math/Math.h"
+#include "idlib/Lib.h"
+#include "renderer/RenderWorld.h"
+#include "renderer/RenderSystem.h"
+#include "framework/d3_arco.h"
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+#else
+#define EMSCRIPTEN_KEEPALIVE
+#endif
+
+// Arco wire pose: METERS, RADIANS, Z-up (yaw about +Z, pitch tilts up/down).
+static float s_camX = 0.0f, s_camY = 0.0f, s_camZ = 0.0f;
+static float s_yaw = 0.0f, s_pitch = 0.0f;
+static float s_fovDeg = 90.0f;
+static bool  s_active = false;
+static int   s_frameCount = 0;
+
+extern "C" {
+
+// Called from Arco's JS client every frame with the predicted self pose.
+EMSCRIPTEN_KEEPALIVE void D3_Arco_SetCamera( float x, float y, float z, float yaw, float pitch, float fovDeg ) {
+	s_camX = x; s_camY = y; s_camZ = z;
+	s_yaw = yaw; s_pitch = pitch;
+	if ( fovDeg > 1.0f ) s_fovDeg = fovDeg;
+	s_active = true;
+}
+
+// Readiness/liveness signal for the JS loader (replaces _arco_frame_count).
+EMSCRIPTEN_KEEPALIVE int D3_Arco_FrameCount( void ) { return s_frameCount; }
+
+// Offscreen capture for the render-regression gate (P1). Writes a TGA into
+// fs_savepath/screenshots that the headless harness reads via Module.FS.
+EMSCRIPTEN_KEEPALIVE void D3_Arco_Readback( void ) {
+	renderSystem->CaptureRenderToFile( "screenshots/d3arco.tga", false );
+}
+
+} // extern "C"
+
+bool D3Arco_Active( void ) { return s_active; }
+
+void D3Arco_BuildView( renderView_t &v ) {
+	// meters -> idTech4 inches (1 / 0.0254). The Arco wire z is ALREADY the eye
+	// (feetZ*0.0254 + EYE_HEIGHT at emit), so no extra eye-height offset here.
+	const float M2I = 39.37007874f;
+	memset( (void *)&v, 0, sizeof( v ) );
+	const int sw = renderSystem->GetScreenWidth();
+	const int sh = renderSystem->GetScreenHeight();
+	v.x = 0; v.y = 0; v.width = sw; v.height = sh;
+	v.fov_x = s_fovDeg;
+	v.fov_y = 2.0f * RAD2DEG( idMath::ATan( idMath::Tan( DEG2RAD( v.fov_x ) * 0.5f ) * (float)sh / (float)sw ) );
+	v.vieworg = idVec3( s_camX * M2I, s_camY * M2I, s_camZ * M2I );
+	// dhewm3 renderView "looks down +X"; idAngles is (pitch,yaw,roll) in degrees.
+	// idTech4 pitch is DOWN-positive, Arco pitch is UP-positive → negate. (P3 verifies signs.)
+	idAngles ang( -RAD2DEG( s_pitch ), RAD2DEG( s_yaw ), 0.0f );
+	v.viewaxis = ang.ToMat3();
+	v.time = Sys_Milliseconds();
+}
+
+void D3Arco_AfterFrame( void ) { s_frameCount++; }
