+/*
+====================
+idMD5Anim::BuildFromGLTF
+
+In-memory equivalent of LoadAnim() (R-GLTF Spike-B): builds this idMD5Anim from a
+glTF-derived clip (RENDER fills gltfAnimClip_t from a GLB) instead of parsing a
+.md5anim file. Mirrors LoadAnim field-for-field so a glTF-animated entity resolves
+through the SHIPPED combat wire unchanged (animNum -> CycleAnim -> idAnim -> idMD5Anim).
+The clip's quaternions are already normalized with w>=0, so only x,y,z are stored
+per the .md5anim convention and CalcW recovers w at sample time.
+====================
+*/
+bool idMD5Anim::BuildFromGLTF( const gltfAnimClip_t &clip ) {
+	int i, j;
+
+	if ( clip.numJoints <= 0 || clip.numFrames <= 0 || clip.frameRate < 0 ) {
+		return false;
+	}
+	if ( clip.joints.Num() != clip.numJoints ||
+	     clip.baseFrame.Num() != clip.numJoints ||
+	     clip.animBits.Num() != clip.numJoints ||
+	     clip.frames.Num() != clip.numFrames * clip.numJoints ) {
+		return false;
+	}
+
+	Free();
+
+	name = clip.name;
+	numFrames = clip.numFrames;
+	numJoints = clip.numJoints;
+	frameRate = clip.frameRate;
+
+	// hierarchy + per-joint anim bits; LoadAnim reads firstComponent + numAnimatedComponents
+	// from the file, we DERIVE them: firstComponent = running popcount, total = sum of popcounts.
+	jointInfo.SetGranularity( 1 );
+	jointInfo.SetNum( numJoints );
+	numAnimatedComponents = 0;
+	for ( i = 0; i < numJoints; i++ ) {
+		// SAME intern table as the model's idMD5Joint names so CheckModelHierarchy matches.
+		jointInfo[ i ].nameIndex = animationLib.JointIndex( clip.joints[ i ].name );
+		jointInfo[ i ].parentNum = clip.joints[ i ].parentNum;
+		int bits = clip.animBits[ i ] & 63;
+		jointInfo[ i ].animBits = bits;
+		jointInfo[ i ].firstComponent = numAnimatedComponents;
+		for ( j = 0; j < 6; j++ ) {
+			if ( bits & ( 1 << j ) ) {
+				numAnimatedComponents++;
+			}
+		}
+	}
+
+	// base frame (direct idJointQuat assign; q already normalized w>=0).
+	baseFrame.SetGranularity( 1 );
+	baseFrame.SetNum( numJoints );
+	for ( i = 0; i < numJoints; i++ ) {
+		baseFrame[ i ] = clip.baseFrame[ i ];
+	}
+
+	// component frames: pack ONLY the animBits-flagged channels per frame/joint,
+	// in [tx,ty,tz,qx,qy,qz] order (rotations store x,y,z; w recovered by CalcW).
+	componentFrames.SetGranularity( 1 );
+	componentFrames.SetNum( numAnimatedComponents * numFrames );
+	float *componentPtr = componentFrames.Ptr();
+	for ( i = 0; i < numFrames; i++ ) {
+		for ( j = 0; j < numJoints; j++ ) {
+			const idJointQuat &jq = clip.frames[ i * numJoints + j ];
+			int bits = jointInfo[ j ].animBits;
+			if ( bits & ANIM_TX ) { *componentPtr++ = jq.t.x; }
+			if ( bits & ANIM_TY ) { *componentPtr++ = jq.t.y; }
+			if ( bits & ANIM_TZ ) { *componentPtr++ = jq.t.z; }
+			if ( bits & ANIM_QX ) { *componentPtr++ = jq.q.x; }
+			if ( bits & ANIM_QY ) { *componentPtr++ = jq.q.y; }
+			if ( bits & ANIM_QZ ) { *componentPtr++ = jq.q.z; }
+		}
+	}
+
+	// bounds: prefer the clip's per-frame bounds; else a conservative box over the
+	// base-pose joint translations (start >= +-64u) so culling never drops the model.
+	bounds.SetGranularity( 1 );
+	bounds.SetNum( numFrames );
+	if ( clip.bounds.Num() == numFrames ) {
+		for ( i = 0; i < numFrames; i++ ) {
+			bounds[ i ] = clip.bounds[ i ];
+		}
+	} else {
+		idBounds def;
+		def[ 0 ].Set( -64.0f, -64.0f, -64.0f );
+		def[ 1 ].Set(  64.0f,  64.0f,  64.0f );
+		for ( i = 0; i < numJoints; i++ ) {
+			def.AddPoint( clip.baseFrame[ i ].t );
+		}
+		for ( i = 0; i < numFrames; i++ ) {
+			bounds[ i ] = def;
+		}
+	}
+
+	// total movement delta — IDENTICAL extraction to LoadAnim (subtracts baseFrame[0].t
+	// from the root joint's translation columns in place, then zeroes baseFrame[0].t).
+	if ( !numAnimatedComponents ) {
+		totaldelta.Zero();
+	} else {
+		componentPtr = &componentFrames[ jointInfo[ 0 ].firstComponent ];
+		if ( jointInfo[ 0 ].animBits & ANIM_TX ) {
+			for ( i = 0; i < numFrames; i++ ) {
+				componentPtr[ numAnimatedComponents * i ] -= baseFrame[ 0 ].t.x;
+			}
+			totaldelta.x = componentPtr[ numAnimatedComponents * ( numFrames - 1 ) ];
+			componentPtr++;
+		} else {
+			totaldelta.x = 0.0f;
+		}
+		if ( jointInfo[ 0 ].animBits & ANIM_TY ) {
+			for ( i = 0; i < numFrames; i++ ) {
+				componentPtr[ numAnimatedComponents * i ] -= baseFrame[ 0 ].t.y;
+			}
+			totaldelta.y = componentPtr[ numAnimatedComponents * ( numFrames - 1 ) ];
+			componentPtr++;
+		} else {
+			totaldelta.y = 0.0f;
+		}
+		if ( jointInfo[ 0 ].animBits & ANIM_TZ ) {
+			for ( i = 0; i < numFrames; i++ ) {
+				componentPtr[ numAnimatedComponents * i ] -= baseFrame[ 0 ].t.z;
+			}
+			totaldelta.z = componentPtr[ numAnimatedComponents * ( numFrames - 1 ) ];
+		} else {
+			totaldelta.z = 0.0f;
+		}
+	}
+	baseFrame[ 0 ].t.Zero();
+
+	// we don't count last frame because it would cause a 1 frame pause at the end
+	animLength = ( ( numFrames - 1 ) * 1000 + frameRate - 1 ) / frameRate;
+
+	return true;
+}
