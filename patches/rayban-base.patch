+/*
+===================
+GameAreaForPoint
+
+Phase 0 (area-streaming): thunk handed to the collision-model bake so cm/ can
+classify a world point's render area without depending on the renderer.
+===================
+*/
+static int GameAreaForPoint( void *ctx, const idVec3 &point ) {
+	return gameRenderWorld ? gameRenderWorld->PointInArea( point ) : -1;
+}
+
+/*
+===================
+idGameLocal::DumpAreaSplit_f
+===================
+*/
+void idGameLocal::DumpAreaSplit_f( const idCmdArgs &args ) {
+	// Boot-region areas kept resident in the boot .bcm (must match
+	// split-bproc-areas.py --boot-areas). Use Args() (the whole arg string), NOT
+	// Argv(1): idCmdArgs tokenizes on commas, so "0,1,2" gives Argv(1)="0".
+	// DumpAreaSplit's parser accepts space- or comma-separated.
+	gameLocal.DumpAreaSplit( args.Args() );
+}
+
+/*
+===================
+idGameLocal::AppendArea_f
+
+Area streaming (Phase 1): bind a deferred area's render model now. Driven from
+JS via D3_AppendArea (buffered to a frame boundary). `appendArea <n>`.
+===================
+*/
+void idGameLocal::AppendArea_f( const idCmdArgs &args ) {
+	if ( args.Argc() < 2 ) {
+		common->Printf( "usage: appendArea <areaNum>\n" );
+		return;
+	}
+	if ( gameRenderWorld == NULL ) {
+		return;
+	}
+	int areaNum = atoi( args.Argv( 1 ) );
+	bool ok = gameRenderWorld->AppendAreaModel( areaNum );
+	common->Printf( "appendArea %d: %s\n", areaNum, ok ? "bound" : "skipped (absent/already loaded)" );
+}
+
+/*
+===================
+idGameLocal::AppendAreaCollision_f
+
+Area streaming (Phase 2): append a deferred area's collision polys/brushes now.
+Driven from JS via D3_AppendArea too (it buffers both appendArea + appendAreaCol).
+`appendAreaCol <n>`.
+===================
+*/
+void idGameLocal::AppendAreaCollision_f( const idCmdArgs &args ) {
+	if ( args.Argc() < 2 ) {
+		common->Printf( "usage: appendAreaCol <areaNum>\n" );
+		return;
+	}
+	if ( collisionModelManager == NULL ) {
+		return;
+	}
+	int areaNum = atoi( args.Argv( 1 ) );
+	bool ok = collisionModelManager->AppendAreaCollision( areaNum );
+	common->Printf( "appendAreaCol %d: %s\n", areaNum, ok ? "appended" : "skipped (no part)" );
+}
+
+/*
+===================
+idGameLocal::DumpAreaSplit
+
+Partition the loaded map by render area and write per-area render/collision/
+entity dumps + json metrics to /save/areadump for scripts/pack-area-stream.py.
+Read-only; never touches the running game. See the Phase 0 build spec.
+===================
+*/
+void idGameLocal::DumpAreaSplit( const char *bootAreas ) {
+	const char *dir = "areadump";
+
+	if ( gameRenderWorld == NULL ) {
+		common->Printf( "dumpAreaSplit: no render world loaded\n" );
+		return;
+	}
+	int numAreas = gameRenderWorld->NumAreas();
+	common->Printf( "dumpAreaSplit: %d render areas; writing to /save/%s\n", numAreas, dir );
+
+	// boot region mask (areas kept resident in the boot .bcm), from the comma
+	// arg (e.g. "0,1,2,...,9"). Must match split-bproc-areas.py --boot-areas.
+	// Manual split — idLexer mis-tokenizes a bare comma-separated int list.
+	bool *isBootArea = (bool *)Mem_ClearedAlloc( numAreas * sizeof( bool ) );
+	int numBoot = 0;
+	if ( bootAreas && bootAreas[0] ) {
+		idStr s = bootAreas;
+		int start = 0;
+		for ( int i = 0; i <= s.Length(); i++ ) {
+			if ( i == s.Length() || s[i] == ',' || s[i] == ' ' ) {
+				if ( i > start ) {
+					int a = atoi( s.Mid( start, i - start ).c_str() );
+					if ( a >= 0 && a < numAreas && !isBootArea[a] ) { isBootArea[a] = true; numBoot++; }
+				}
+				start = i + 1;
+			}
+		}
+	}
+	common->Printf( "dumpAreaSplit: boot region = %d areas\n", numBoot );
+
+	// (1) RENDER: per-area _areaN.bproc.part + _shared.bproc.part + render.json
+	gameRenderWorld->DumpAreaModels( dir );
+
+	// (3) ENTITIES: bucket by origin; bootstrap (worldspawn/player/cross-area
+	//     target+bind/void) forced into _boot. Re-parse the .map fresh so we
+	//     do not depend on the live mapFile (may be freed mid-game).
+	idMapFile  localMap;
+	idMapFile *mf = mapFile;
+	if ( mf == NULL ) {
+		if ( localMap.Parse( idStr( mapFileName ) + ".map" ) ) {
+			mf = &localMap;
+		}
+	}
+
+	// (2) COLLISION: census (collision.json) + per-area split (boot .bcm + parts)
+	if ( collisionModelManager ) {
+		collisionModelManager->DumpAreaCollisionStats( dir, numAreas, GameAreaForPoint, NULL );
+		unsigned int mapCRC = mf ? mf->GetGeometryCRC() : 0;
+		collisionModelManager->DumpAreaCollision( dir, numAreas, isBootArea, mapCRC, GameAreaForPoint, NULL );
+	}
+
+	if ( mf == NULL ) {
+		common->Printf( "dumpAreaSplit: no map file (%s) — skipped entity dump\n", mapFileName.c_str() );
+		Mem_Free( isBootArea );
+		return;
+	}
+
+	int numEnt = mf->GetNumEntities();
+	idList<idStr>	names;		names.SetNum( numEnt );
+	idList<int>		areas;		areas.SetNum( numEnt );
+	idList<bool>	boot;		boot.SetNum( numEnt );
+	idHashIndex		nameHash;
+
+	for ( int i = 0; i < numEnt; i++ ) {
+		const idDict &ep = mf->GetEntity( i )->epairs;
+		idStr nm = ep.GetString( "name", "" );
+		nm.ToLower();
+		names[i] = nm;
+		idVec3 org = ep.GetVector( "origin", "0 0 0" );
+		int a = gameRenderWorld->PointInArea( org );
+		areas[i] = a;
+		boot[i] = false;
+		if ( nm.Length() ) {
+			nameHash.Add( nameHash.GenerateKey( nm, false ), i );
+		}
+	}
+
+	// bootstrap classification (pass 1): worldspawn / player / void
+	for ( int i = 0; i < numEnt; i++ ) {
+		const idDict &ep = mf->GetEntity( i )->epairs;
+		idStr cls = ep.GetString( "classname", "" );
+		cls.ToLower();
+		if ( i == 0 || cls == "worldspawn" || cls.Cmpn( "info_player", 11 ) == 0 ) {
+			boot[i] = true;
+		}
+		if ( areas[i] < 0 || areas[i] >= numAreas ) {
+			boot[i] = true;	// unclassifiable -> always boot
+		}
+	}
+
+	// edge analysis (target* + bind*): record edges, force cross-area pairs boot
+	idFile *targets = fileSystem->OpenFileWrite( idStr( dir ) + "/targets.json" );
+	if ( targets ) {
+		targets->WriteFloatString( "{\n  \"targetEdges\": [\n" );
+	}
+	bool firstEdge = true;
+	int crossTargetEdges = 0, crossBindEdges = 0;
+
+	for ( int i = 0; i < numEnt; i++ ) {
+		const idDict &ep = mf->GetEntity( i )->epairs;
+		// gather outgoing references: target*, and bind / bindMaster
+		for ( int pass = 0; pass < 2; pass++ ) {
+			const char *prefix = ( pass == 0 ) ? "target" : "bind";
+			const idKeyValue *kv = NULL;
+			while ( ( kv = ep.MatchPrefix( prefix, kv ) ) != NULL ) {
+				idStr tname = kv->GetValue();
+				tname.ToLower();
+				if ( !tname.Length() ) {
+					continue;
+				}
+				int j = -1;
+				for ( int h = nameHash.First( nameHash.GenerateKey( tname, false ) ); h >= 0; h = nameHash.Next( h ) ) {
+					if ( names[h] == tname ) { j = h; break; }
+				}
+				if ( j < 0 ) {
+					continue;
+				}
+				bool cross = ( areas[i] != areas[j] );
+				if ( cross ) {
+					boot[i] = true;
+					boot[j] = true;
+					if ( pass == 0 ) crossTargetEdges++; else crossBindEdges++;
+				}
+				if ( targets ) {
+					targets->WriteFloatString( "%s    { \"kind\": \"%s\", \"from\": \"%s\", \"fromArea\": %d, \"to\": \"%s\", \"toArea\": %d }",
+						firstEdge ? "" : ",\n", prefix, names[i].c_str(), areas[i], names[j].c_str(), areas[j] );
+					firstEdge = false;
+				}
+			}
+		}
+	}
+	if ( targets ) {
+		targets->WriteFloatString( "\n  ],\n  \"crossTargetEdges\": %d,\n  \"crossBindEdges\": %d\n}\n", crossTargetEdges, crossBindEdges );
+		fileSystem->CloseFile( targets );
+	}
+
+	// write per-area + boot entity buckets (binary idDict blocks: count, then dicts)
+	int *areaCounts = (int *)Mem_ClearedAlloc( numAreas * sizeof( int ) );
+	int bootCount = 0;
+	idFile **areaFiles = (idFile **)Mem_ClearedAlloc( numAreas * sizeof( idFile * ) );
+	idFile *bootFile = fileSystem->OpenFileWrite( idStr( dir ) + "/_boot.entities" );
+	// reserve a slot for the count by writing a placeholder we patch via re-count:
+	// simplest: two-pass — first count, then write counts as headers.
+	// Here we stream and keep counts; rewrite headers by closing/reopening is
+	// awkward, so write count LAST is not possible with a forward file. Instead
+	// write each bucket as: repeated [int hasMore=1, dict]; terminate with int 0.
+	for ( int i = 0; i < numEnt; i++ ) {
+		const idDict &ep = mf->GetEntity( i )->epairs;
+		if ( boot[i] ) {
+			if ( bootFile ) {
+				bootFile->WriteInt( 1 );
+				ep.WriteToFileHandle( bootFile );
+			}
+			bootCount++;
+		} else {
+			int a = areas[i];
+			if ( areaFiles[a] == NULL ) {
+				areaFiles[a] = fileSystem->OpenFileWrite( idStr( dir ) + "/_area" + a + ".entities" );
+			}
+			if ( areaFiles[a] ) {
