+/*
+===============================================================================
+
+	Binary collision model cache (.bcm) — byte-for-byte mirror of the ASCII
+	Write and Parse path above, via idFile binary ops. Skips the idLexer
+	tokenize + number-conversion (the measured ~946ms .cm cost on this map).
+	Any failure (bad magic/version, CRC mismatch, truncated read) returns
+	false so BuildModels falls through to the ASCII path.
+
+===============================================================================
+*/
+
+void idCollisionModelManagerLocal::WriteBinaryNodes( idFile *fp, cm_node_t *node ) {
+	fp->WriteInt( node->planeType );
+	fp->WriteFloat( node->planeDist );
+	if ( node->planeType != -1 ) {
+		WriteBinaryNodes( fp, node->children[0] );
+		WriteBinaryNodes( fp, node->children[1] );
+	}
+}
+
+void idCollisionModelManagerLocal::WriteBinaryPolygons( idFile *fp, cm_node_t *node ) {
+	cm_polygonRef_t *pref;
+	cm_polygon_t *p;
+	int i;
+
+	for ( pref = node->polygons; pref; pref = pref->next ) {
+		p = pref->p;
+		if ( p->checkcount == checkCount ) {
+			continue;
+		}
+		p->checkcount = checkCount;
+		fp->WriteInt( p->numEdges );
+		for ( i = 0; i < p->numEdges; i++ ) {
+			fp->WriteInt( p->edges[i] );
+		}
+		fp->WriteVec3( p->plane.Normal() );
+		fp->WriteFloat( p->plane.Dist() );
+		fp->WriteVec3( p->bounds[0] );
+		fp->WriteVec3( p->bounds[1] );
+		fp->WriteString( p->material->GetName() );
+	}
+	if ( node->planeType != -1 ) {
+		WriteBinaryPolygons( fp, node->children[0] );
+		WriteBinaryPolygons( fp, node->children[1] );
+	}
+}
+
+void idCollisionModelManagerLocal::WriteBinaryBrushes( idFile *fp, cm_node_t *node ) {
+	cm_brushRef_t *bref;
+	cm_brush_t *b;
+	int i;
+
+	for ( bref = node->brushes; bref; bref = bref->next ) {
+		b = bref->b;
+		if ( b->checkcount == checkCount ) {
+			continue;
+		}
+		b->checkcount = checkCount;
+		fp->WriteInt( b->numPlanes );
+		for ( i = 0; i < b->numPlanes; i++ ) {
+			fp->WriteVec3( b->planes[i].Normal() );
+			fp->WriteFloat( b->planes[i].Dist() );
+		}
+		fp->WriteVec3( b->bounds[0] );
+		fp->WriteVec3( b->bounds[1] );
+		fp->WriteInt( b->contents );
+	}
+	if ( node->planeType != -1 ) {
+		WriteBinaryBrushes( fp, node->children[0] );
+		WriteBinaryBrushes( fp, node->children[1] );
+	}
+}
+
+void idCollisionModelManagerLocal::WriteBinaryCollisionModel( idFile *fp, cm_model_t *model ) {
+	int i, polygonMemory, brushMemory;
+
+	fp->WriteString( model->name.c_str() );
+	// vertices
+	fp->WriteInt( model->numVertices );
+	for ( i = 0; i < model->numVertices; i++ ) {
+		fp->WriteVec3( model->vertices[i].p );
+	}
+	// edges
+	fp->WriteInt( model->numEdges );
+	for ( i = 0; i < model->numEdges; i++ ) {
+		fp->WriteInt( model->edges[i].vertexNum[0] );
+		fp->WriteInt( model->edges[i].vertexNum[1] );
+		fp->WriteInt( model->edges[i].internal );
+		fp->WriteInt( model->edges[i].numUsers );
+	}
+	// nodes
+	WriteBinaryNodes( fp, model->node );
+	// polygons (checkCount++ once for CountPolygonMemory, once for the write — each dedups)
+	checkCount++;
+	polygonMemory = CountPolygonMemory( model->node );
+	fp->WriteInt( polygonMemory );
+	fp->WriteInt( model->numPolygons );
+	checkCount++;
+	WriteBinaryPolygons( fp, model->node );
+	// brushes
+	checkCount++;
+	brushMemory = CountBrushMemory( model->node );
+	fp->WriteInt( brushMemory );
+	fp->WriteInt( model->numBrushes );
+	checkCount++;
+	WriteBinaryBrushes( fp, model->node );
+}
+
+void idCollisionModelManagerLocal::WriteBinaryCollisionModelsToFile( const char *filename, int firstModel, int lastModel, unsigned int mapFileCRC ) {
+	int i;
+	idFile *fp;
+	idStr name;
+
+	name = filename;
+	name.SetFileExtension( BCM_FILE_EXT );
+
+	fp = fileSystem->OpenFileWrite( name, "fs_devpath" );
+	if ( !fp ) {
+		common->Warning( "WriteBinaryCollisionModelsToFile: Error opening file %s\n", name.c_str() );
+		return;
+	}
+	fp->WriteInt( BCM_MAGIC );
+	fp->WriteInt( BCM_VERSION );
+	fp->WriteInt( (int)mapFileCRC );
+	fp->WriteInt( lastModel - firstModel );
+	for ( i = firstModel; i < lastModel; i++ ) {
+		WriteBinaryCollisionModel( fp, models[ i ] );
+	}
+	fileSystem->CloseFile( fp );
+	common->Printf( "wrote binary collision cache %s\n", name.c_str() );
+}
+
+cm_node_t *idCollisionModelManagerLocal::ParseBinaryNodes( idFile *fp, cm_model_t *model, cm_node_t *parent ) {
+	cm_node_t *node;
+
+	model->numNodes++;
+	node = AllocNode( model, model->numNodes < NODE_BLOCK_SIZE_SMALL ? NODE_BLOCK_SIZE_SMALL : NODE_BLOCK_SIZE_LARGE );
+	node->brushes = NULL;
+	node->polygons = NULL;
+	node->parent = parent;
+	fp->ReadInt( node->planeType );
+	fp->ReadFloat( node->planeDist );
+	if ( node->planeType != -1 ) {
+		node->children[0] = ParseBinaryNodes( fp, model, node );
+		node->children[1] = ParseBinaryNodes( fp, model, node );
+	}
+	return node;
+}
+
+void idCollisionModelManagerLocal::ParseBinaryVertices( idFile *fp, cm_model_t *model ) {
+	int i;
+
+	fp->ReadInt( model->numVertices );
+	model->maxVertices = model->numVertices;
+	model->vertices = (cm_vertex_t *) Mem_Alloc( model->maxVertices * sizeof( cm_vertex_t ) );
+	for ( i = 0; i < model->numVertices; i++ ) {
+		fp->ReadVec3( model->vertices[i].p );
+		model->vertices[i].side = 0;
+		model->vertices[i].sideSet = 0;
+		model->vertices[i].checkcount = 0;
+	}
+}
+
+void idCollisionModelManagerLocal::ParseBinaryEdges( idFile *fp, cm_model_t *model ) {
+	int i, tmp;
+
+	fp->ReadInt( model->numEdges );
+	model->maxEdges = model->numEdges;
+	model->edges = (cm_edge_t *) Mem_Alloc( model->maxEdges * sizeof( cm_edge_t ) );
+	for ( i = 0; i < model->numEdges; i++ ) {
+		fp->ReadInt( model->edges[i].vertexNum[0] );
+		fp->ReadInt( model->edges[i].vertexNum[1] );
+		model->edges[i].side = 0;
+		model->edges[i].sideSet = 0;
+		fp->ReadInt( tmp ); model->edges[i].internal = (unsigned short)tmp;
+		fp->ReadInt( tmp ); model->edges[i].numUsers = (unsigned short)tmp;
+		model->edges[i].normal = vec3_origin;
+		model->edges[i].checkcount = 0;
+		model->numInternalEdges += model->edges[i].internal;
+	}
+}
+
+void idCollisionModelManagerLocal::ParseBinaryPolygons( idFile *fp, cm_model_t *model ) {
+	cm_polygon_t *p;
+	int i, n, numEdges, numPolys, polygonMemory;
+	idVec3 normal;
+	float dist;
+	idStr matName;
+
+	fp->ReadInt( polygonMemory );
+	if ( polygonMemory > 0 ) {
+		model->polygonBlock = (cm_polygonBlock_t *) Mem_Alloc( sizeof( cm_polygonBlock_t ) + polygonMemory );
+		model->polygonBlock->bytesRemaining = polygonMemory;
+		model->polygonBlock->next = ( (byte *) model->polygonBlock ) + sizeof( cm_polygonBlock_t );
+	}
+	fp->ReadInt( numPolys );
+	for ( n = 0; n < numPolys; n++ ) {
+		fp->ReadInt( numEdges );
+		p = AllocPolygon( model, numEdges );
+		p->numEdges = numEdges;
+		for ( i = 0; i < numEdges; i++ ) {
+			fp->ReadInt( p->edges[i] );
+		}
+		fp->ReadVec3( normal );
+		p->plane.SetNormal( normal );
+		fp->ReadFloat( dist );
+		p->plane.SetDist( dist );
+		fp->ReadVec3( p->bounds[0] );
+		fp->ReadVec3( p->bounds[1] );
+		fp->ReadString( matName );
+		p->material = declManager->FindMaterial( matName );
+		p->contents = p->material->GetContentFlags();
+		p->checkcount = 0;
+		R_FilterPolygonIntoTree( model, model->node, NULL, p );
+	}
+}
+
+void idCollisionModelManagerLocal::ParseBinaryBrushes( idFile *fp, cm_model_t *model ) {
+	cm_brush_t *b;
+	int i, n, numPlanes, numBrushes, brushMemory;
+	idVec3 normal;
+	float dist;
+
+	fp->ReadInt( brushMemory );
+	if ( brushMemory > 0 ) {
+		model->brushBlock = (cm_brushBlock_t *) Mem_Alloc( sizeof( cm_brushBlock_t ) + brushMemory );
+		model->brushBlock->bytesRemaining = brushMemory;
+		model->brushBlock->next = ( (byte *) model->brushBlock ) + sizeof( cm_brushBlock_t );
+	}
+	fp->ReadInt( numBrushes );
+	for ( n = 0; n < numBrushes; n++ ) {
+		fp->ReadInt( numPlanes );
+		b = AllocBrush( model, numPlanes );
+		b->numPlanes = numPlanes;
+		for ( i = 0; i < numPlanes; i++ ) {
+			fp->ReadVec3( normal );
+			b->planes[i].SetNormal( normal );
+			fp->ReadFloat( dist );
+			b->planes[i].SetDist( dist );
+		}
+		fp->ReadVec3( b->bounds[0] );
+		fp->ReadVec3( b->bounds[1] );
+		fp->ReadInt( b->contents );
+		b->checkcount = 0;
+		b->primitiveNum = 0;
+		R_FilterBrushIntoTree( model, model->node, NULL, b );
+	}
+}
+
+bool idCollisionModelManagerLocal::ParseBinaryCollisionModel( idFile *fp ) {
+	cm_model_t *model;
+	idStr name;
+
+	if ( numModels >= MAX_SUBMODELS ) {
+		common->Error( "LoadBinaryCollisionModelFile: no free slots" );
+		return false;
+	}
+	model = AllocModel();
+	models[numModels] = model;
+	numModels++;
+
+	fp->ReadString( name );
+	model->name = name;
+	ParseBinaryVertices( fp, model );
+	ParseBinaryEdges( fp, model );
+	model->node = ParseBinaryNodes( fp, model, NULL );
+	ParseBinaryPolygons( fp, model );
+	ParseBinaryBrushes( fp, model );
+
+	// calculate edge normals
+	checkCount++;
+	CalculateEdgeNormals( model, model->node );
+	// get model bounds from brush and polygon bounds
+	CM_GetNodeBounds( &model->bounds, model->node );
+	// get model contents
+	model->contents = CM_GetNodeContents( model->node );
+	// total memory used by this model
+	model->usedMemory = model->numVertices * sizeof(cm_vertex_t) +
+						model->numEdges * sizeof(cm_edge_t) +
+						model->polygonMemory +
+						model->brushMemory +
+						model->numNodes * sizeof(cm_node_t) +
+						model->numPolygonRefs * sizeof(cm_polygonRef_t) +
+						model->numBrushRefs * sizeof(cm_brushRef_t);
+	return true;
+}
+
+bool idCollisionModelManagerLocal::LoadBinaryCollisionModelFile( const char *name, unsigned int mapFileCRC ) {
+	idStr fileName;
+	idFile *fp;
+	int magic, version, numModelsInFile, crcInt, i;
+
+	fileName = name;
+	fileName.SetFileExtension( BCM_FILE_EXT );
+	fp = fileSystem->OpenFileRead( fileName );
+	if ( !fp ) {
+		return false;
+	}
+	magic = version = 0;
+	fp->ReadInt( magic );
+	fp->ReadInt( version );
+	if ( magic != BCM_MAGIC || version != BCM_VERSION ) {
+		fileSystem->CloseFile( fp );
+		return false;
+	}
+	crcInt = 0;
+	fp->ReadInt( crcInt );
+	if ( mapFileCRC && (unsigned int)crcInt != mapFileCRC ) {
+		common->Printf( "%s is out of date\n", fileName.c_str() );
+		fileSystem->CloseFile( fp );
+		return false;
+	}
+	numModelsInFile = 0;
+	fp->ReadInt( numModelsInFile );
+	for ( i = 0; i < numModelsInFile; i++ ) {
+		if ( !ParseBinaryCollisionModel( fp ) ) {
+			fileSystem->CloseFile( fp );
+			return false;
+		}
+	}
+	fileSystem->CloseFile( fp );
+	common->Printf( "loaded binary collision cache %s\n", fileName.c_str() );
+	return true;
+}
