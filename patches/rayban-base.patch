+/*
+=====================
+idAI::WriteToSnapshot
+
+Arco COMBAT P1: replicate the monster's pose (origin + yaw + health) to clients. The base
+idEntity bodies are empty and the monster physics don't network, so write it explicitly.
+Byte layout MUST stay symmetric with ReadFromSnapshot below.
+=====================
+*/
+void idAI::WriteToSnapshot( idBitMsgDelta &msg ) const {
+	const idVec3 &org = GetPhysics()->GetOrigin();
+	msg.WriteDeltaFloat( 0.0f, org.x );
+	msg.WriteDeltaFloat( 0.0f, org.y );
+	msg.WriteDeltaFloat( 0.0f, org.z );
+	msg.WriteDeltaFloat( 0.0f, current_yaw );
+	msg.WriteShort( health );
+	// Arco COMBAT P2: per-channel (TORSO+LEGS) anim selector so the client animates the monster.
+	for ( int ch = ANIMCHANNEL_TORSO; ch <= ANIMCHANNEL_LEGS; ch++ ) {
+		idAnimBlend *blend = ( (idAnimator &)animator ).CurrentAnim( ch );
+		msg.WriteBits( blend ? blend->AnimNum() : 0, 12 );
+	}
+}
+
+/*
+=====================
+idAI::ReadFromSnapshot
+=====================
+*/
+void idAI::ReadFromSnapshot( const idBitMsgDelta &msg ) {
+	idVec3 org;
+	org.x = msg.ReadDeltaFloat( 0.0f );
+	org.y = msg.ReadDeltaFloat( 0.0f );
+	org.z = msg.ReadDeltaFloat( 0.0f );
+	current_yaw = msg.ReadDeltaFloat( 0.0f );
+	health = msg.ReadShort();
+
+	// Arco COMBAT P2: drive the animator from the replicated per-channel anim selector so the MD5
+	// animates (UpdateAnimation in ClientPredictionThink advances it). animNum-only for now; the
+	// client (re)cycles a channel only when its anim changes. Frame-phase sync is a fast-follow.
+	for ( int ch = ANIMCHANNEL_TORSO; ch <= ANIMCHANNEL_LEGS; ch++ ) {
+		int animNum = msg.ReadBits( 12 );
+		if ( animNum > 0 ) {
+			idAnimBlend *cur = animator.CurrentAnim( ch );
+			if ( !cur || cur->AnimNum() != animNum ) {
+				animator.CycleAnim( ch, animNum, gameLocal.time, 0 );
+			}
+		}
+	}
+
+	// Drive the client-side pose from the server-authoritative state (P7 will interpolate;
+	// for now snap each snapshot — the client never runs the AI brain, see Think guard).
+	ideal_yaw = current_yaw;
+	viewAxis = idAngles( 0.0f, current_yaw, 0.0f ).ToMat3();
+	GetPhysics()->SetOrigin( org );
+	GetPhysics()->SetAxis( viewAxis );
+	UpdateVisuals();
+}
