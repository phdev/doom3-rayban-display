+/*
+==============
+idPlayer::UpdateFlashlight
+
+Iter 72: a permanent, view-attached projected flashlight, decoupled from the
+base-DOOM-3 weapon_flashlight (which is a weapon that replaces your gun).
+Mirrors the weapon's projected-light construction (lights/flashlight5 + the
+def's flashRadius/flashTarget/flashUp/flashRight) but follows the player view
+and stays lit no matter which weapon is equipped. Never drains.
+==============
+*/
+void idPlayer::UpdateFlashlight( void ) {
+	// Off / dead / spectating / cinematic: drop the light.
+	if ( !flashlightOn || ( health <= 0 ) || spectating || gameLocal.inCinematic ) {
+		if ( flashlightHandle != -1 ) {
+			gameRenderWorld->FreeLightDef( flashlightHandle );
+			flashlightHandle = -1;
+		}
+		return;
+	}
+
+	// One-time static setup (the decl system is up by the first Think).
+	if ( flashlight.shader == NULL ) {
+		flashlight.pointLight = false;					// projected spotlight
+		flashlight.shader = declManager->FindMaterial( "lights/flashlight5", false );
+		flashlight.lightRadius[0] = flashlight.lightRadius[1] = flashlight.lightRadius[2] = 400.0f;
+		flashlight.shaderParms[ SHADERPARM_RED ]		= 1.0f;
+		flashlight.shaderParms[ SHADERPARM_GREEN ]		= 1.0f;
+		flashlight.shaderParms[ SHADERPARM_BLUE ]		= 1.0f;
+		flashlight.shaderParms[ SHADERPARM_TIMESCALE ]	= 1.0f;
+		// Projection frustum from weapon_flashlight.def (light-local space).
+		flashlight.target	= idVec3(    0.0f,   0.0f, 1280.0f );
+		flashlight.up		= idVec3(    0.0f, 640.0f,    0.0f );
+		flashlight.right	= idVec3( -640.0f,   0.0f,    0.0f );
+		flashlight.end		= flashlight.target;
+		// A view-following shadow-casting light re-derives every frame; skip
+		// shadows so the always-on light stays cheap on the mobile target.
+		flashlight.noShadows = true;
+	}
+
+	// Follow the eye/view each frame. The frustum target is light-local +Z, up
+	// is +Y, right is -X (per the def), so map +Z->forward, +Y->up, +X->left.
+	idVec3 forward, right, up;
+	viewAngles.ToVectors( &forward, &right, &up );
+	flashlight.origin = GetEyePosition() + forward * 8.0f;
+	flashlight.axis[0] = -right;
+	flashlight.axis[1] = up;
+	flashlight.axis[2] = forward;
+	flashlight.shaderParms[ SHADERPARM_TIMEOFFSET ] = -MS2SEC( gameLocal.time );
+
+	if ( flashlightHandle == -1 ) {
+		flashlightHandle = gameRenderWorld->AddLightDef( &flashlight );
+	} else {
+		gameRenderWorld->UpdateLightDef( flashlightHandle, &flashlight );
+	}
+}
