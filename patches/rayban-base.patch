+/*
+================
+idCollisionModelManagerLocal::DumpAreaCollisionStats
+
+Phase 0 (area-streaming bake): census the world collision model (model 0) by
+render area. For every polygon/brush in the BSP (deduped via checkcount), the
+centroid is classified with the caller's PointInArea thunk; a primitive whose 8
+bound corners map to more than one area is a "straddler" that Phase 2 will keep
+in the always-boot _shared bucket. Writes <dir>/collision.json. Read-only.
+================
+*/
+void idCollisionModelManagerLocal::DumpAreaCollisionStats( const char *dir, int numAreas, cmAreaForPointFn fn, void *ctx ) {
+	if ( numModels < 1 || models[0] == NULL || fn == NULL ) {
+		return;
+	}
+	cm_model_t *model = models[0];
+
+	int *areaPolys = (int *)Mem_ClearedAlloc( numAreas * sizeof( int ) );
+	int *areaBrushes = (int *)Mem_ClearedAlloc( numAreas * sizeof( int ) );
+	int totalPolys = 0, crossPolys = 0, voidPolys = 0;
+	int totalBrushes = 0, crossBrushes = 0, voidBrushes = 0;
+
+	// explicit-stack BSP walk (avoids recursion-helper churn)
+	idList<cm_node_t *> stack;
+	stack.Append( model->node );
+
+	// --- polygons ---
+	checkCount++;
+	while ( stack.Num() ) {
+		cm_node_t *node = stack[ stack.Num() - 1 ];
+		stack.RemoveIndex( stack.Num() - 1 );
+		for ( cm_polygonRef_t *pref = node->polygons; pref; pref = pref->next ) {
+			cm_polygon_t *p = pref->p;
+			if ( p->checkcount == checkCount ) {
+				continue;
+			}
+			p->checkcount = checkCount;
+			totalPolys++;
+			idVec3 centroid = ( p->bounds[0] + p->bounds[1] ) * 0.5f;
+			int a = fn( ctx, centroid );
+			if ( a < 0 || a >= numAreas ) {
+				voidPolys++;
+			} else {
+				// straddle test: do the 8 bound corners agree on the area?
+				bool cross = false;
+				for ( int c = 0; c < 8 && !cross; c++ ) {
+					idVec3 corner( p->bounds[(c>>0)&1][0], p->bounds[(c>>1)&1][1], p->bounds[(c>>2)&1][2] );
+					int ca = fn( ctx, corner );
+					if ( ca >= 0 && ca != a ) {
+						cross = true;
+					}
+				}
+				if ( cross ) {
+					crossPolys++;
+				} else {
+					areaPolys[a]++;
+				}
+			}
+		}
+		if ( node->planeType != -1 ) {
+			stack.Append( node->children[0] );
+			stack.Append( node->children[1] );
+		}
+	}
+
+	// --- brushes ---
+	checkCount++;
+	stack.Clear();
+	stack.Append( model->node );
+	while ( stack.Num() ) {
+		cm_node_t *node = stack[ stack.Num() - 1 ];
+		stack.RemoveIndex( stack.Num() - 1 );
+		for ( cm_brushRef_t *bref = node->brushes; bref; bref = bref->next ) {
+			cm_brush_t *b = bref->b;
+			if ( b->checkcount == checkCount ) {
+				continue;
+			}
+			b->checkcount = checkCount;
+			totalBrushes++;
+			idVec3 centroid = ( b->bounds[0] + b->bounds[1] ) * 0.5f;
+			int a = fn( ctx, centroid );
+			if ( a < 0 || a >= numAreas ) {
+				voidBrushes++;
+			} else {
+				bool cross = false;
+				for ( int c = 0; c < 8 && !cross; c++ ) {
+					idVec3 corner( b->bounds[(c>>0)&1][0], b->bounds[(c>>1)&1][1], b->bounds[(c>>2)&1][2] );
+					int ca = fn( ctx, corner );
+					if ( ca >= 0 && ca != a ) {
+						cross = true;
+					}
+				}
+				if ( cross ) {
+					crossBrushes++;
+				} else {
+					areaBrushes[a]++;
+				}
+			}
+		}
+		if ( node->planeType != -1 ) {
+			stack.Append( node->children[0] );
+			stack.Append( node->children[1] );
+		}
+	}
+
+	// write json fragment
+	idStr path = idStr( dir ) + "/collision.json";
+	idFile *json = fileSystem->OpenFileWrite( path );
+	if ( json ) {
+		json->WriteFloatString( "{\n  \"numAreas\": %d,\n", numAreas );
+		json->WriteFloatString( "  \"totalPolys\": %d, \"crossAreaPolys\": %d, \"voidPolys\": %d,\n", totalPolys, crossPolys, voidPolys );
+		json->WriteFloatString( "  \"totalBrushes\": %d, \"crossAreaBrushes\": %d, \"voidBrushes\": %d,\n", totalBrushes, crossBrushes, voidBrushes );
+		json->WriteFloatString( "  \"perArea\": [\n" );
+		for ( int i = 0; i < numAreas; i++ ) {
+			json->WriteFloatString( "%s    { \"area\": %d, \"polys\": %d, \"brushes\": %d }",
+				i ? ",\n" : "", i, areaPolys[i], areaBrushes[i] );
+		}
+		json->WriteFloatString( "\n  ]\n}\n" );
+		fileSystem->CloseFile( json );
+	}
+	common->Printf( "DumpAreaCollisionStats: %d polys (%d cross-area, %d void), %d brushes (%d cross, %d void)\n",
+		totalPolys, crossPolys, voidPolys, totalBrushes, crossBrushes, voidBrushes );
+
+	Mem_Free( areaPolys );
+	Mem_Free( areaBrushes );
+}
+
+/*
+================
+Phase 2 collision serialization helpers
+================
+*/
+static int CM_PolySize( cm_polygon_t *p ) {
+	return sizeof( cm_polygon_t ) + ( p->numEdges - 1 ) * sizeof( p->edges[0] );
+}
+static int CM_BrushSize( cm_brush_t *b ) {
+	return sizeof( cm_brush_t ) + ( b->numPlanes - 1 ) * sizeof( b->planes[0] );
+}
+static void CM_WritePoly( idFile *fp, cm_polygon_t *p ) {
+	fp->WriteInt( p->numEdges );
+	for ( int i = 0; i < p->numEdges; i++ ) {
+		fp->WriteInt( p->edges[i] );
+	}
+	fp->WriteVec3( p->plane.Normal() );
+	fp->WriteFloat( p->plane.Dist() );
+	fp->WriteVec3( p->bounds[0] );
+	fp->WriteVec3( p->bounds[1] );
+	fp->WriteString( p->material->GetName() );
+}
+static void CM_WriteBrush( idFile *fp, cm_brush_t *b ) {
+	fp->WriteInt( b->numPlanes );
+	for ( int i = 0; i < b->numPlanes; i++ ) {
+		fp->WriteVec3( b->planes[i].Normal() );
+		fp->WriteFloat( b->planes[i].Dist() );
+	}
+	fp->WriteVec3( b->bounds[0] );
+	fp->WriteVec3( b->bounds[1] );
+	fp->WriteInt( b->contents );
+}
+
+// Returns the bucket for a polygon: -2 = resident (boot .bcm) for void /
+// cross-area straddler / boot-region; else the area number (-> _areaN.bcm.part).
+int idCollisionModelManagerLocal::PolyAreaBucket( cm_polygon_t *p, int numAreas, const bool *isBootArea, cmAreaForPointFn fn, void *ctx ) {
+	idVec3 centroid = ( p->bounds[0] + p->bounds[1] ) * 0.5f;
+	int a = fn( ctx, centroid );
+	if ( a < 0 || a >= numAreas ) {
+		return -2;
+	}
+	for ( int c = 0; c < 8; c++ ) {
+		idVec3 corner( p->bounds[(c>>0)&1][0], p->bounds[(c>>1)&1][1], p->bounds[(c>>2)&1][2] );
+		int ca = fn( ctx, corner );
+		if ( ca >= 0 && ca != a ) {
+			return -2;	// straddles an area boundary -> always-boot
+		}
+	}
+	if ( isBootArea && isBootArea[a] ) {
+		return -2;
+	}
+	return a;
+}
+
+int idCollisionModelManagerLocal::BrushAreaBucket( cm_brush_t *b, int numAreas, const bool *isBootArea, cmAreaForPointFn fn, void *ctx ) {
+	idVec3 centroid = ( b->bounds[0] + b->bounds[1] ) * 0.5f;
+	int a = fn( ctx, centroid );
+	if ( a < 0 || a >= numAreas ) {
+		return -2;
+	}
+	for ( int c = 0; c < 8; c++ ) {
+		idVec3 corner( b->bounds[(c>>0)&1][0], b->bounds[(c>>1)&1][1], b->bounds[(c>>2)&1][2] );
+		int ca = fn( ctx, corner );
+		if ( ca >= 0 && ca != a ) {
+			return -2;
+		}
+	}
+	if ( isBootArea && isBootArea[a] ) {
+		return -2;
+	}
+	return a;
+}
+
+/*
+================
+idCollisionModelManagerLocal::DumpAreaCollision
+
+Phase 2 bake: serialize the world collision model (model 0) split by render area.
+Boot .bcm = full vert/edge/node skeleton + resident polys/brushes (void, straddler,
+boot-region). Per-area parts = each non-boot area's polys/brushes (poly/brush
+sub-stream only; they reference the global edge array which lives in the boot
+.bcm). The append reader (AppendAreaCollision) filters them into the existing
+tree at runtime. mapCRC must be the live map's geometry CRC so the reduced boot
+.bcm passes LoadBinaryCollisionModelFile's freshness check. Read-only.
+================
+*/
+void idCollisionModelManagerLocal::DumpAreaCollision( const char *dir, int numAreas, const bool *isBootArea, unsigned int mapCRC, cmAreaForPointFn fn, void *ctx ) {
+	if ( numModels < 1 || models[0] == NULL || fn == NULL ) {
+		return;
+	}
+	cm_model_t *model = models[0];
+
+	// collect deduped polys + brushes with their bucket
+	idList<cm_polygon_t *> polys;
+	idList<int> polyBkt;
+	idList<cm_brush_t *> brushes;
+	idList<int> brushBkt;
+	idList<cm_node_t *> stack;
+
+	checkCount++;
+	stack.Append( model->node );
+	while ( stack.Num() ) {
+		cm_node_t *node = stack[ stack.Num() - 1 ];
+		stack.RemoveIndex( stack.Num() - 1 );
+		for ( cm_polygonRef_t *pr = node->polygons; pr; pr = pr->next ) {
+			if ( pr->p->checkcount == checkCount ) {
+				continue;
+			}
+			pr->p->checkcount = checkCount;
+			polys.Append( pr->p );
+			polyBkt.Append( PolyAreaBucket( pr->p, numAreas, isBootArea, fn, ctx ) );
+		}
+		if ( node->planeType != -1 ) {
+			stack.Append( node->children[0] );
+			stack.Append( node->children[1] );
+		}
+	}
+	checkCount++;
+	stack.Clear();
+	stack.Append( model->node );
+	while ( stack.Num() ) {
+		cm_node_t *node = stack[ stack.Num() - 1 ];
+		stack.RemoveIndex( stack.Num() - 1 );
+		for ( cm_brushRef_t *br = node->brushes; br; br = br->next ) {
+			if ( br->b->checkcount == checkCount ) {
+				continue;
+			}
+			br->b->checkcount = checkCount;
+			brushes.Append( br->b );
+			brushBkt.Append( BrushAreaBucket( br->b, numAreas, isBootArea, fn, ctx ) );
+		}
+		if ( node->planeType != -1 ) {
+			stack.Append( node->children[0] );
+			stack.Append( node->children[1] );
+		}
+	}
+
+	// --- boot .bcm: header + skeleton + resident (bucket == -2) polys/brushes ---
+	idStr bootPath = idStr( dir ) + "/enpro.boot.bcm";
+	idFile *fp = fileSystem->OpenFileWrite( bootPath );
+	int residentPolys = 0, residentBrushes = 0;
+	if ( fp ) {
+		fp->WriteInt( BCM_MAGIC );
+		fp->WriteInt( BCM_VERSION );
+		fp->WriteInt( (int)mapCRC );
+		// MAP collision models only: model 0 (the world) is reduced/split per-area;
+		// the inline brush models 1..numMapModels-1 (func_door, movers, func_static)
+		// stay WHOLE and boot-resident — dropping them breaks every door/mover's
+		// collision. numMapModels (not numModels) excludes runtime trm/moveable
+		// models loaded after the map (else the boot .bcm carries stale junk).
+		int nMap = ( numMapModels > 0 ) ? numMapModels : numModels;
+		fp->WriteInt( nMap );
+		fp->WriteString( model->name.c_str() );
+		fp->WriteInt( model->numVertices );
+		for ( int i = 0; i < model->numVertices; i++ ) {
+			fp->WriteVec3( model->vertices[i].p );
+		}
+		fp->WriteInt( model->numEdges );
+		for ( int i = 0; i < model->numEdges; i++ ) {
+			fp->WriteInt( model->edges[i].vertexNum[0] );
+			fp->WriteInt( model->edges[i].vertexNum[1] );
+			fp->WriteInt( model->edges[i].internal );
+			fp->WriteInt( model->edges[i].numUsers );
+		}
+		WriteBinaryNodes( fp, model->node );
+		// resident polygons
+		int pm = 0;
+		for ( int i = 0; i < polys.Num(); i++ ) {
+			if ( polyBkt[i] == -2 ) { pm += CM_PolySize( polys[i] ); residentPolys++; }
+		}
+		fp->WriteInt( pm );
+		fp->WriteInt( residentPolys );
+		for ( int i = 0; i < polys.Num(); i++ ) {
+			if ( polyBkt[i] == -2 ) CM_WritePoly( fp, polys[i] );
+		}
+		// resident brushes
+		int bm = 0;
+		for ( int i = 0; i < brushes.Num(); i++ ) {
+			if ( brushBkt[i] == -2 ) { bm += CM_BrushSize( brushes[i] ); residentBrushes++; }
+		}
+		fp->WriteInt( bm );
+		fp->WriteInt( residentBrushes );
+		for ( int i = 0; i < brushes.Num(); i++ ) {
+			if ( brushBkt[i] == -2 ) CM_WriteBrush( fp, brushes[i] );
+		}
+		// inline brush models (doors/movers/func_static) — whole, boot-resident.
+		for ( int mi = 1; mi < nMap; mi++ ) {
+			if ( models[mi] ) {
+				WriteBinaryCollisionModel( fp, models[mi] );
+			}
+		}
+		fileSystem->CloseFile( fp );
+	}
+
+	// --- per-area parts (non-boot areas only) ---
+	int streamedAreas = 0;
+	for ( int area = 0; area < numAreas; area++ ) {
+		if ( isBootArea && isBootArea[area] ) {
+			continue;
+		}
+		int pm = 0, pc = 0, bm = 0, bc = 0;
+		for ( int i = 0; i < polys.Num(); i++ ) {
+			if ( polyBkt[i] == area ) { pm += CM_PolySize( polys[i] ); pc++; }
+		}
+		for ( int i = 0; i < brushes.Num(); i++ ) {
+			if ( brushBkt[i] == area ) { bm += CM_BrushSize( brushes[i] ); bc++; }
+		}
+		if ( pc == 0 && bc == 0 ) {
+			continue;
+		}
+		idStr partPath = idStr( dir ) + "/_area" + area + ".bcm.part";
+		idFile *pf = fileSystem->OpenFileWrite( partPath );
+		if ( !pf ) {
+			continue;
+		}
+		pf->WriteInt( pm );
+		pf->WriteInt( pc );
+		for ( int i = 0; i < polys.Num(); i++ ) {
+			if ( polyBkt[i] == area ) CM_WritePoly( pf, polys[i] );
+		}
+		pf->WriteInt( bm );
+		pf->WriteInt( bc );
+		for ( int i = 0; i < brushes.Num(); i++ ) {
+			if ( brushBkt[i] == area ) CM_WriteBrush( pf, brushes[i] );
+		}
+		fileSystem->CloseFile( pf );
+		streamedAreas++;
+	}
+
+	common->Printf( "DumpAreaCollision: boot .bcm = %d/%d polys + %d/%d brushes resident; %d areas streamed\n",
+		residentPolys, polys.Num(), residentBrushes, brushes.Num(), streamedAreas );
+}
+
+/*
+================
+idCollisionModelManagerLocal::AppendAreaCollision
+
+Phase 2 runtime: append one area's polys/brushes (from areadump/_areaN.bcm.part)
+into the world model's existing BSP. Mirrors ParseBinaryPolygons/Brushes but does
+NOT reallocate polygonBlock — AllocPolygon/AllocBrush overflow to Mem_Alloc, so
+appended primitives just malloc individually. Edge normals are recomputed once
+(rotation traces need them). Never rebuilds the tree, so traces stay stable.
+================
+*/
+bool idCollisionModelManagerLocal::AppendAreaCollision( int areaNum ) {
+	if ( numModels < 1 || models[0] == NULL ) {
+		return false;
+	}
+	cm_model_t *model = models[0];
+	idStr path = va( "areadump/_area%i.bcm.part", areaNum );
+	idFile *fp = fileSystem->OpenFileRead( path );
+	if ( fp == NULL ) {
+		return false;
+	}
+
+	int pm = 0, numPolys = 0;
+	fp->ReadInt( pm );			// polygonMemory — intentionally ignored (no block realloc)
+	fp->ReadInt( numPolys );
+	for ( int n = 0; n < numPolys; n++ ) {
+		int numEdges = 0;
+		fp->ReadInt( numEdges );
+		cm_polygon_t *p = AllocPolygon( model, numEdges );
+		p->numEdges = numEdges;
+		for ( int i = 0; i < numEdges; i++ ) {
+			fp->ReadInt( p->edges[i] );
+		}
+		idVec3 normal;
+		fp->ReadVec3( normal );
+		p->plane.SetNormal( normal );
+		float dist;
+		fp->ReadFloat( dist );
+		p->plane.SetDist( dist );
+		fp->ReadVec3( p->bounds[0] );
+		fp->ReadVec3( p->bounds[1] );
+		idStr matName;
+		fp->ReadString( matName );
+		p->material = declManager->FindMaterial( matName );
+		p->contents = p->material->GetContentFlags();
+		p->checkcount = 0;
+		R_FilterPolygonIntoTree( model, model->node, NULL, p );
+		model->contents |= p->contents;
+	}
+
+	int bm = 0, numBrushes = 0;
+	fp->ReadInt( bm );
+	fp->ReadInt( numBrushes );
+	for ( int n = 0; n < numBrushes; n++ ) {
+		int numPlanes = 0;
+		fp->ReadInt( numPlanes );
+		cm_brush_t *b = AllocBrush( model, numPlanes );
+		b->numPlanes = numPlanes;
+		for ( int i = 0; i < numPlanes; i++ ) {
+			idVec3 normal;
+			fp->ReadVec3( normal );
+			b->planes[i].SetNormal( normal );
+			float dist;
+			fp->ReadFloat( dist );
+			b->planes[i].SetDist( dist );
+		}
+		fp->ReadVec3( b->bounds[0] );
+		fp->ReadVec3( b->bounds[1] );
+		fp->ReadInt( b->contents );
+		b->checkcount = 0;
+		b->primitiveNum = 0;
+		R_FilterBrushIntoTree( model, model->node, NULL, b );
+		model->contents |= b->contents;
+	}
+	fileSystem->CloseFile( fp );
+
+	// rotation traces need edge normals; recompute once for the whole tree.
+	CalculateEdgeNormals( model, model->node );
+	return true;
+}
