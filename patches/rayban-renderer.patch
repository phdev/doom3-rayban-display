+		common->Warning( "LoadGLTF: '%s' has no BIN chunk", fileName );
+		fileSystem->FreeFile( fileBuf );
+		return false;
+	}
+
+	idList<gltfAccessor_t> accessors;
+	idList<gltfBufferView_t> bufferViews;
+	idList<gltfPrim_t> prims;
+	bool gotMesh0 = false;
+
+	idLexer lex;
+	lex.LoadMemory( json, (int)jsonLen, fileName );
+	lex.SetFlags( LEXFL_NOERRORS | LEXFL_NOWARNINGS | LEXFL_NOFATALERRORS );
+
+	idToken tok;
+	if ( !lex.ExpectTokenString( "{" ) ) { lex.FreeSource(); fileSystem->FreeFile( fileBuf ); return false; }
+	while ( lex.ReadToken( &tok ) ) {
+		if ( tok == "}" ) break;
+		if ( tok == "," ) continue;
+		idStr key = tok;
+		lex.ExpectTokenString( ":" );
+		if ( key == "accessors" ) {
+			lex.ExpectTokenString( "[" );
+			while ( lex.ReadToken( &tok ) ) {
+				if ( tok == "]" ) break;
+				if ( tok == "," ) continue;	// tok == "{"
