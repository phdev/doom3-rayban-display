+/*
+================================================================================
+R-GLTF SPIKE-A — minimal static glTF / GLB loader (RENDER track).
+
+De-risks the content-forge GLB -> engine path: parse the binary GLB container +
+the glTF JSON (stock idLexer), decode the first mesh's float POSITION/NORMAL/
+TEXCOORD_0 + indices into the engine's 60-byte idDrawVert layout, and build
+idRenderModelStatic surfaces the WebGPU capture-replay backend replays with ZERO
+backend change. STATIC only — skinning/anim is Spike-B + the idMD5Anim bridge,
+which touches neo/anim and needs SPINE patch-split coordination. Material =
+default for now (the ORM/.mtr contract is content-forge's half). Lives in
+Model.cpp on purpose: a new .cpp would touch neo/CMakeLists.txt (SPINE's
+rayban-base.patch) — this keeps spike-A 100% in rayban-renderer.patch.
+================================================================================
+*/
+struct gltfAccessor_t { int bufferView; int byteOffset; int componentType; int count; int numComp; };
+struct gltfBufferView_t { int byteOffset; int byteLength; int byteStride; };
+struct gltfPrim_t { int pos; int normal; int uv; int indices; int material; };
+
+static int GLTF_NumComp( const idStr &type ) {
+	if ( type == "SCALAR" ) return 1;
+	if ( type == "VEC2" ) return 2;
+	if ( type == "VEC3" ) return 3;
+	if ( type == "VEC4" ) return 4;
+	if ( type == "MAT4" ) return 16;
+	return 1;
+}
+
+// skip one balanced JSON value (object / array / scalar)
+static void GLTF_SkipValue( idLexer &lex ) {
+	idToken tok;
+	if ( !lex.ReadToken( &tok ) ) return;
+	if ( tok == "{" || tok == "[" ) {
+		int depth = 1;
+		while ( depth > 0 && lex.ReadToken( &tok ) ) {
+			if ( tok == "{" || tok == "[" ) depth++;
+			else if ( tok == "}" || tok == "]" ) depth--;
+		}
+	}
+}
+
+bool idRenderModelStatic::LoadGLTF( const char *fileName ) {
+#ifdef __EMSCRIPTEN__
+	EM_ASM({ window.__d3GltfCalled = (window.__d3GltfCalled||0)+1; });   // JS-visible signal (Printf doesn't reach JS)
+#endif
+	void *fileBuf = NULL;
+	int fileLen = fileSystem->ReadFile( fileName, &fileBuf, NULL );
+	if ( fileLen <= 20 || !fileBuf ) {
+		if ( fileBuf ) fileSystem->FreeFile( fileBuf );
+		return false;
+	}
+	const byte *p = (const byte *)fileBuf;
+	// GLB header: magic 'glTF' (0x46546C67), version, length
+	if ( *(const unsigned int *)( p + 0 ) != 0x46546C67u ) {
+		common->Warning( "LoadGLTF: '%s' is not a binary GLB (only GLB supported in spike-A)", fileName );
+		fileSystem->FreeFile( fileBuf );
+		return false;
+	}
+	unsigned int jsonLen  = *(const unsigned int *)( p + 12 );
+	unsigned int jsonType = *(const unsigned int *)( p + 16 );
+	if ( jsonType != 0x4E4F534Au || 20 + jsonLen > (unsigned)fileLen ) {	// 'JSON'
+		fileSystem->FreeFile( fileBuf );
+		return false;
+	}
+	const char *json = (const char *)( p + 20 );
+	// chunk 1 = BIN, right after the JSON chunk
+	unsigned int binOff = 20 + jsonLen;
+	const byte *bin = NULL;
+	if ( binOff + 8 <= (unsigned)fileLen && *(const unsigned int *)( p + binOff + 4 ) == 0x004E4942u ) {	// 'BIN\0'
+		bin = p + binOff + 8;
+	}
