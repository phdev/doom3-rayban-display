+    // Iter 16: the _currentRender substitute — a canvas-sized texture the
+    // final pass copies the frame into right before haze surfaces draw.
+    void ensureCurrentRenderTarget(uint32_t w, uint32_t h) {
+        if (currentRenderTex && currentRenderW == w && currentRenderH == h) return;
+        if (currentRenderView) { wgpuTextureViewRelease(currentRenderView); currentRenderView = nullptr; }
+        if (currentRenderTex)  { wgpuTextureRelease(currentRenderTex); currentRenderTex = nullptr; }
