+		}
+		tri->numIndexes = numIndexes;
+		if ( !nbase ) tri->generateNormals = true;
+
+		modelSurface_t surf;
+		surf.id = pi;
+		surf.shader = tr.defaultMaterial;	// SPIKE: real ORM/.mtr is content-forge's half
+		surf.geometry = tri;
+		AddSurface( surf );
+	}
+
+	fileSystem->FreeFile( fileBuf );
+	common->Printf( "LoadGLTF: '%s' -> %d surfaces\n", fileName, surfaces.Num() );
+#ifdef __EMSCRIPTEN__
+	EM_ASM({ window.__d3GltfSurfaces = $0; window.__d3GltfLoaded = ($0 > 0); }, surfaces.Num());
+#endif
+	return surfaces.Num() > 0;
+}
