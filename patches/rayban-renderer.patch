+        pd.depthStencil = &dss;
+        interactionPipeline = wgpuDeviceCreateRenderPipeline(device, &pd);
+        wgpuShaderModuleRelease(mod);
+        if (!interactionPipeline) { fprintf(stderr, "[WebGPU] interaction pipeline FAILED\n"); return; }
