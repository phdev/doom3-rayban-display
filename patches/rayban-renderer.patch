+			}
+		} else if ( key == "meshes" ) {
+			lex.ExpectTokenString( "[" );
+			int meshIdx = 0;
+			while ( lex.ReadToken( &tok ) ) {
+				if ( tok == "]" ) break;
+				if ( tok == "," ) continue;
+				bool firstMesh = ( meshIdx == 0 );
