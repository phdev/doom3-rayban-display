+/*
+===============================================================================
+
+	Binary .bproc cache. Models are captured during the ASCII parse (raw verts,
+	before FinishSurfaces mutates them); interAreaPortals + nodes are written
+	from the built structures (which preserve the source data). On load the
+	model/portal/node blocks rebuild via the same Alloc/AddSurface/FinishSurfaces
+	+ portal/winding reconstruction the ASCII path uses. Magic/version guarded;
+	any short read or bad tag returns false → ASCII fallback.
+
+===============================================================================
+*/
+extern "C" void D3_ParseTimeLog(const char*, int);
+#define BPROC_MAGIC			(('B'<<0)|('P'<<8)|('R'<<16)|('C'<<24))
+#define BPROC_VERSION		1
+#define BPROC_TAG_END		0
+#define BPROC_TAG_MODEL		1
+#define BPROC_TAG_PORTALS	2
+#define BPROC_TAG_NODES		3
+
+void idRenderWorldLocal::WriteBinaryProcModel( idFile *fp, idRenderModel *model ) {
+	fp->WriteInt( BPROC_TAG_MODEL );
+	fp->WriteString( model->Name() );
+	fp->WriteInt( model->NumSurfaces() );
+	for ( int i = 0; i < model->NumSurfaces(); i++ ) {
+		const modelSurface_t *surf = model->Surface( i );
+		const srfTriangles_t *tri = surf->geometry;
+		fp->WriteString( surf->shader->GetName() );
+		fp->WriteInt( tri->numVerts );
+		fp->WriteInt( tri->numIndexes );
+		for ( int j = 0; j < tri->numVerts; j++ ) {
+			fp->WriteVec3( tri->verts[j].xyz );
+			fp->WriteFloat( tri->verts[j].st[0] );
+			fp->WriteFloat( tri->verts[j].st[1] );
+			fp->WriteVec3( tri->verts[j].normal );
+		}
+		for ( int j = 0; j < tri->numIndexes; j++ ) {
+			fp->WriteInt( tri->indexes[j] );
+		}
+	}
+}
+
+idRenderModel *idRenderWorldLocal::ParseBinaryProcModel( idFile *fp ) {
+	idStr name, matName;
+	int numSurfaces = 0;
+
+	idRenderModel *model = renderModelManager->AllocModel();
+	fp->ReadString( name );
+	model->InitEmpty( name );
+	fp->ReadInt( numSurfaces );
+	for ( int i = 0; i < numSurfaces; i++ ) {
+		modelSurface_t surf;
+		fp->ReadString( matName );
+		surf.shader = declManager->FindMaterial( matName );
+		((idMaterial *)surf.shader)->AddReference();
+		srfTriangles_t *tri = R_AllocStaticTriSurf();
+		surf.geometry = tri;
+		fp->ReadInt( tri->numVerts );
+		fp->ReadInt( tri->numIndexes );
+		R_AllocStaticTriSurfVerts( tri, tri->numVerts );
+		for ( int j = 0; j < tri->numVerts; j++ ) {
+			fp->ReadVec3( tri->verts[j].xyz );
+			fp->ReadFloat( tri->verts[j].st[0] );
+			fp->ReadFloat( tri->verts[j].st[1] );
+			fp->ReadVec3( tri->verts[j].normal );
+		}
+		R_AllocStaticTriSurfIndexes( tri, tri->numIndexes );
+		for ( int j = 0; j < tri->numIndexes; j++ ) {
+			int idx = 0;
+			fp->ReadInt( idx );
+			tri->indexes[j] = idx;
+		}
+		model->AddSurface( surf );
+	}
+	model->FinishSurfaces();
+	return model;
+}
+
+void idRenderWorldLocal::WriteBinaryInterAreaPortals( idFile *fp ) {
+	fp->WriteInt( BPROC_TAG_PORTALS );
+	fp->WriteInt( numPortalAreas );
+	fp->WriteInt( numInterAreaPortals );
+	for ( int i = 0; i < numInterAreaPortals; i++ ) {
+		portal_t *p0 = doublePortals[i].portals[0];	// intoArea = a2, original winding
+		portal_t *p1 = doublePortals[i].portals[1];	// intoArea = a1, reversed winding
+		idWinding *w = p0->w;
+		int numPoints = w->GetNumPoints();
+		fp->WriteInt( numPoints );
+		fp->WriteInt( p1->intoArea );	// a1
+		fp->WriteInt( p0->intoArea );	// a2
+		for ( int j = 0; j < numPoints; j++ ) {
+			fp->WriteVec3( (*w)[j].ToVec3() );
+		}
+	}
+}
+
+void idRenderWorldLocal::ParseBinaryInterAreaPortals( idFile *fp ) {
+	int i, j;
+
+	fp->ReadInt( numPortalAreas );
+	portalAreas = (portalArea_t *)R_ClearedStaticAlloc( numPortalAreas * sizeof( portalAreas[0] ) );
+	areaScreenRect = (idScreenRect *) R_ClearedStaticAlloc( numPortalAreas * sizeof( idScreenRect ) );
+	SetupAreaRefs();
+	fp->ReadInt( numInterAreaPortals );
+	doublePortals = (doublePortal_t *)R_ClearedStaticAlloc( numInterAreaPortals * sizeof( doublePortals[0] ) );
+
+	for ( i = 0; i < numInterAreaPortals; i++ ) {
+		int numPoints = 0, a1 = 0, a2 = 0;
+		idWinding *w;
+		portal_t *p;
+
+		fp->ReadInt( numPoints );
+		fp->ReadInt( a1 );
+		fp->ReadInt( a2 );
+
+		w = new idWinding( numPoints );
+		w->SetNumPoints( numPoints );
+		for ( j = 0; j < numPoints; j++ ) {
+			idVec3 pt;
+			fp->ReadVec3( pt );
+			(*w)[j][0] = pt[0];
+			(*w)[j][1] = pt[1];
+			(*w)[j][2] = pt[2];
+			(*w)[j][3] = 0;
+			(*w)[j][4] = 0;
+		}
+
+		p = (portal_t *)R_ClearedStaticAlloc( sizeof( *p ) );
+		p->intoArea = a2;
+		p->doublePortal = &doublePortals[i];
+		p->w = w;
+		p->w->GetPlane( p->plane );
+		p->next = portalAreas[a1].portals;
+		portalAreas[a1].portals = p;
+		doublePortals[i].portals[0] = p;
+
+		p = (portal_t *)R_ClearedStaticAlloc( sizeof( *p ) );
+		p->intoArea = a1;
+		p->doublePortal = &doublePortals[i];
+		p->w = w->Reverse();
+		p->w->GetPlane( p->plane );
+		p->next = portalAreas[a2].portals;
+		portalAreas[a2].portals = p;
+		doublePortals[i].portals[1] = p;
+	}
+}
+
+void idRenderWorldLocal::WriteBinaryNodes( idFile *fp ) {
+	fp->WriteInt( BPROC_TAG_NODES );
+	fp->WriteInt( numAreaNodes );
+	for ( int i = 0; i < numAreaNodes; i++ ) {
+		areaNode_t *node = &areaNodes[i];
+		fp->WriteFloat( node->plane[0] );
+		fp->WriteFloat( node->plane[1] );
+		fp->WriteFloat( node->plane[2] );
+		fp->WriteFloat( node->plane[3] );
+		fp->WriteInt( node->children[0] );
+		fp->WriteInt( node->children[1] );
+	}
+}
+
+void idRenderWorldLocal::ParseBinaryNodes( idFile *fp ) {
+	fp->ReadInt( numAreaNodes );
+	areaNodes = (areaNode_t *)R_ClearedStaticAlloc( numAreaNodes * sizeof( areaNodes[0] ) );
+	for ( int i = 0; i < numAreaNodes; i++ ) {
+		areaNode_t *node = &areaNodes[i];
+		fp->ReadFloat( node->plane[0] );
+		fp->ReadFloat( node->plane[1] );
+		fp->ReadFloat( node->plane[2] );
+		fp->ReadFloat( node->plane[3] );
+		fp->ReadInt( node->children[0] );
+		fp->ReadInt( node->children[1] );
+	}
+}
+
+bool idRenderWorldLocal::LoadBinaryProc( const char *name, ID_TIME_T sourceTimeStamp ) {
+	idStr fileName = name;
+	fileName.SetFileExtension( "bproc" );
+	idFile *fp = fileSystem->OpenFileRead( fileName );
+	if ( !fp ) {
+		return false;
+	}
+	int magic = 0, ver = 0;
+	fp->ReadInt( magic );
+	fp->ReadInt( ver );
+	if ( magic != BPROC_MAGIC || ver != BPROC_VERSION ) {
+		fileSystem->CloseFile( fp );
+		return false;
+	}
+
+	mapName = name;
+	mapTimeStamp = sourceTimeStamp;
+
+	idRenderModel *lastModel;
+	while ( 1 ) {
+		int tag = BPROC_TAG_END;
+		if ( fp->ReadInt( tag ) != (int)sizeof( int ) ) {	// short read = truncated/corrupt
+			fileSystem->CloseFile( fp );
+			return false;
+		}
+		if ( tag == BPROC_TAG_END ) {
+			break;
+		} else if ( tag == BPROC_TAG_MODEL ) {
+			lastModel = ParseBinaryProcModel( fp );
+			renderModelManager->AddModel( lastModel );
+			localModels.Append( lastModel );
+		} else if ( tag == BPROC_TAG_PORTALS ) {
+			ParseBinaryInterAreaPortals( fp );
+		} else if ( tag == BPROC_TAG_NODES ) {
+			ParseBinaryNodes( fp );
+		} else {
+			fileSystem->CloseFile( fp );
+			return false;	// bad tag = corrupt
+		}
+	}
+	fileSystem->CloseFile( fp );
+	return true;
+}
