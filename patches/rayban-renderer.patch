+    WGPURenderPipeline      shadowZFailPipeline = nullptr;
+    WGPURenderPipeline      shadowZPassPipeline = nullptr;
+    WGPURenderPipeline      shadowZFailUndoPipeline = nullptr;    // iter 39: inverted ops — stencil restore
+    WGPURenderPipeline      shadowZPassUndoPipeline = nullptr;
+    WGPUBuffer              dbgReadBuf = nullptr;                 // iter 46: -898 GPU readback probe
+    bool                    dbgReadPending = false;
+    bool                    dbgReadDone = false;
+    WGPURenderPipeline      shadowDebugPipeline = nullptr;        // iter 38: -994 magenta volumes
+    WGPURenderPipeline      shadowDebugDepthPipeline = nullptr;   // iter 38: -993 magenta + Less depth
+    WGPUBindGroupLayout     shadowBGL = nullptr;
+    WGPUBindGroup           shadowBindGroups[kMaxRecordSlots]  = {nullptr};
+    WGPUBuffer              shadowVertexBuf = nullptr;
+    uint32_t                shadowVertexCap = 0;
