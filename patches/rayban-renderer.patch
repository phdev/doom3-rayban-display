+                dd.format = WGPUTextureFormat_Depth24PlusStencil8;
+                dd.usage = WGPUTextureUsage_RenderAttachment;
+                subviewDepthTex[g] = wgpuDeviceCreateTexture(device, &dd);
+                subviewDepthView[g] = subviewDepthTex[g] ? wgpuTextureCreateView(subviewDepthTex[g], nullptr) : nullptr;
+            }
+            if (!subviewView[g] || !subviewDepthView[g]) continue;
