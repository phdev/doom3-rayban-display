+    int                     preloadSeenCount = 0;    // cache count already fully covered
+    int                     preloadLoggedTotal = 0;  // last cache size we logged "complete" for
+    uint32_t                lastPublishedShadowVols = 0xFFFFFFFFu;   // iter 31: diag shadow state
+    // Iter 30: delta-upload mirrors (CPU copy of last-uploaded accumulator
