+    WGPUBuffer              shadowIndexBuf = nullptr;
+    uint32_t                shadowIndexCap = 0;
+    uint8_t*                shadowIndexMirror = nullptr;
+    uint32_t                shadowIndexMirrorBytes = 0, shadowIndexMirrorCap = 0;
