+        td.size = { w, h, 1 };
+        td.mipLevelCount = 1;
+        td.sampleCount = 1;
+        td.dimension = WGPUTextureDimension_2D;
+        td.format = surfaceFormat;
+        td.usage = WGPUTextureUsage_CopyDst | WGPUTextureUsage_TextureBinding;
+        td.label = { "currentRender", WGPU_STRLEN };
+        currentRenderTex = wgpuDeviceCreateTexture(device, &td);
+        currentRenderView = currentRenderTex ? wgpuTextureCreateView(currentRenderTex, nullptr) : nullptr;
+        currentRenderW = w; currentRenderH = h;
+        currentRenderGen++;   // existing haze bind groups now stale
+    }
