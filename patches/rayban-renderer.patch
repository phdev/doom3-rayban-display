+    void ensureBloomTargets(uint32_t w, uint32_t h) {
+        uint32_t bw = w / 4u; if (bw < 64u) bw = 64u;
+        uint32_t bh = h / 4u; if (bh < 64u) bh = 64u;
+        if (bloomTexA && bloomW == bw && bloomH == bh) return;
+        if (bloomViewA) { wgpuTextureViewRelease(bloomViewA); bloomViewA = nullptr; }
+        if (bloomViewB) { wgpuTextureViewRelease(bloomViewB); bloomViewB = nullptr; }
+        if (bloomTexA)  { wgpuTextureRelease(bloomTexA); bloomTexA = nullptr; }
+        if (bloomTexB)  { wgpuTextureRelease(bloomTexB); bloomTexB = nullptr; }
+        WGPUTextureDescriptor td = {};
+        td.size = { bw, bh, 1 };
+        td.mipLevelCount = 1;
+        td.sampleCount = 1;
+        td.dimension = WGPUTextureDimension_2D;
+        td.format = surfaceFormat;
+        td.usage = WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_TextureBinding;
+        td.label = { "bloom", WGPU_STRLEN };
+        bloomTexA = wgpuDeviceCreateTexture(device, &td);
+        bloomTexB = wgpuDeviceCreateTexture(device, &td);
+        bloomViewA = bloomTexA ? wgpuTextureCreateView(bloomTexA, nullptr) : nullptr;
+        bloomViewB = bloomTexB ? wgpuTextureCreateView(bloomTexB, nullptr) : nullptr;
+        bloomW = bw; bloomH = bh;
+        bloomGen++;
+    }
