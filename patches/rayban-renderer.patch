+				while ( lex.ReadToken( &tok ) ) {
+					if ( tok == "}" ) break;
+					if ( tok == "," ) continue;
+					idStr k = tok; lex.ExpectTokenString( ":" );
+					if ( k == "bufferView" ) a.bufferView = lex.ParseInt();
+					else if ( k == "byteOffset" ) a.byteOffset = lex.ParseInt();
+					else if ( k == "componentType" ) a.componentType = lex.ParseInt();
+					else if ( k == "count" ) a.count = lex.ParseInt();
+					else if ( k == "type" ) { idToken t2; lex.ReadToken( &t2 ); a.numComp = GLTF_NumComp( t2 ); }
+					else GLTF_SkipValue( lex );
+				}
+				accessors.Append( a );
+			}
+		} else if ( key == "bufferViews" ) {
+			lex.ExpectTokenString( "[" );
+			while ( lex.ReadToken( &tok ) ) {
+				if ( tok == "]" ) break;
+				if ( tok == "," ) continue;
+				gltfBufferView_t bv; bv.byteOffset = 0; bv.byteLength = 0; bv.byteStride = 0;
+				while ( lex.ReadToken( &tok ) ) {
+					if ( tok == "}" ) break;
+					if ( tok == "," ) continue;
+					idStr k = tok; lex.ExpectTokenString( ":" );
+					if ( k == "byteOffset" ) bv.byteOffset = lex.ParseInt();
+					else if ( k == "byteLength" ) bv.byteLength = lex.ParseInt();
+					else if ( k == "byteStride" ) bv.byteStride = lex.ParseInt();
