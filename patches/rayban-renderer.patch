+    idGpuSampler CreateSampler(bool linearMin, bool linearMag, bool linearMip,
+                                 bool repeatU, bool repeatV) override {
+#if D3_WEBGPU_AVAILABLE
+        WGPUSamplerDescriptor sd = {};
+        sd.minFilter = linearMin ? WGPUFilterMode_Linear : WGPUFilterMode_Nearest;
+        sd.magFilter = linearMag ? WGPUFilterMode_Linear : WGPUFilterMode_Nearest;
+        sd.mipmapFilter = linearMip ? WGPUMipmapFilterMode_Linear : WGPUMipmapFilterMode_Nearest;
+        sd.addressModeU = repeatU ? WGPUAddressMode_Repeat : WGPUAddressMode_ClampToEdge;
+        sd.addressModeV = repeatV ? WGPUAddressMode_Repeat : WGPUAddressMode_ClampToEdge;
+        sd.addressModeW = WGPUAddressMode_ClampToEdge;
+        sd.maxAnisotropy = 1;
+        sd.lodMaxClamp = 32.0f;
+        WGPUSampler s = wgpuDeviceCreateSampler(device, &sd);
+        return { (uint64_t)s };
+#else
+        (void)linearMin; (void)linearMag; (void)linearMip; (void)repeatU; (void)repeatV;
+        return {};
+#endif
+    }
