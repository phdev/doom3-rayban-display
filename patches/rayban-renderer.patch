+/*
+================
+idRenderWorldLocal::DumpAreaModels
+
+Phase 0 (area-streaming bake): write every parsed world model to a per-area
+.bproc.part stream so scripts/pack-area-stream.py can assemble the streaming
+blob. "_areaN" models go to <dir>/_areaN.bproc.part (one per render area);
+everything else (inline brush models, shared geometry) is concatenated into
+<dir>/_shared.bproc.part and is always boot-loaded. Each .part is the same
+tagged stream LoadBinaryProc reads (MAGIC, VERSION, [MODEL...], END), so the
+Phase 1 reader needs no new parser. A render.json fragment records counts.
+Read-only: never called unless the dumpAreaSplit console command runs.
+================
+*/
+void idRenderWorldLocal::DumpAreaModels( const char *dir ) {
+	idStr			path;
+	idFile *		shared;
+	int				sharedModels = 0, sharedSurfs = 0;
+
+	// _shared.bproc.part — all non-_areaN models (always boot-loaded).
+	path = idStr( dir ) + "/_shared.bproc.part";
+	shared = fileSystem->OpenFileWrite( path );
+	if ( shared ) {
+		shared->WriteInt( BPROC_MAGIC );
+		shared->WriteInt( BPROC_VERSION );
+	}
+
+	// render.json fragment (per-area surf/vert/index counts; the packer reads
+	// the actual .part byte sizes off disk).
+	idStr jsonPath = idStr( dir ) + "/render.json";
+	idFile *json = fileSystem->OpenFileWrite( jsonPath );
+	if ( json ) {
+		json->WriteFloatString( "{\n  \"numAreas\": %d,\n  \"areas\": [\n", numPortalAreas );
+	}
+	bool firstArea = true;
+
+	for ( int m = 0; m < localModels.Num(); m++ ) {
+		idRenderModel *model = localModels[m];
+		const char *name = model->Name();
+		int areaNum = -1;
+		if ( idStr::Cmpn( name, "_area", 5 ) == 0 ) {
+			areaNum = atoi( name + 5 );
+		}
+
+		// count verts/indexes for the json fragment
+		int surfs = model->NumSurfaces();
+		int verts = 0, indexes = 0;
+		for ( int s = 0; s < surfs; s++ ) {
+			const srfTriangles_t *tri = model->Surface( s )->geometry;
+			if ( tri ) {
+				verts += tri->numVerts;
+				indexes += tri->numIndexes;
+			}
+		}
+
+		if ( areaNum >= 0 && areaNum < numPortalAreas ) {
+			path = idStr( dir ) + "/" + name + ".bproc.part";
+			idFile *fp = fileSystem->OpenFileWrite( path );
+			if ( fp ) {
+				fp->WriteInt( BPROC_MAGIC );
+				fp->WriteInt( BPROC_VERSION );
+				WriteBinaryProcModel( fp, model );
+				fp->WriteInt( BPROC_TAG_END );
+				fileSystem->CloseFile( fp );
+			}
+			if ( json ) {
+				json->WriteFloatString( "%s    { \"area\": %d, \"surfs\": %d, \"verts\": %d, \"indexes\": %d }",
+					firstArea ? "" : ",\n", areaNum, surfs, verts, indexes );
+				firstArea = false;
+			}
+		} else {
+			// shared / inline brush model
+			if ( shared ) {
+				WriteBinaryProcModel( shared, model );
+			}
+			sharedModels++;
+			sharedSurfs += surfs;
+		}
+	}
+
+	if ( shared ) {
+		shared->WriteInt( BPROC_TAG_END );
+		fileSystem->CloseFile( shared );
+	}
+	if ( json ) {
+		json->WriteFloatString( "\n  ],\n  \"shared\": { \"models\": %d, \"surfs\": %d }\n}\n", sharedModels, sharedSurfs );
+		fileSystem->CloseFile( json );
+	}
+	common->Printf( "DumpAreaModels: wrote %d area models + %d shared models to %s\n",
+		numPortalAreas, sharedModels, dir );
+}
