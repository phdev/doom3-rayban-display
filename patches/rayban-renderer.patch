+/*
+================================================================================
+
+RenderBackend_WebGPU.cpp — WebGPU backend (Phase 5 partial).
+
+STATUS
+------
+Phase 5 partial: Init() picks up the JS-preinitialized device. Buffer /
+Texture / Sampler resource ops implemented against the real Dawn C API.
+Pipeline / BindGroup / RenderPass / Draw still stubbed (the remaining
+~70% of Phase 5).
+
+Build: requires --use-port=emdawnwebgpu (set in scripts/build-dhewm3.sh)
+and -DD3_WEBGPU_BACKEND=1 (also set).
+
+ID SCHEME
+---------
+Backend resource handles (idGpuBuffer etc.) store the raw WGPU object
+pointer cast to uint64_t. Avoids a separate handle table; works because
+emscripten's pointer width fits in 64 bits. Zero id == null/invalid.
+
+================================================================================
+*/
+
+#include "RenderBackend.h"
+
+#if defined(D3_WEBGPU_BACKEND) && defined(__EMSCRIPTEN__)
+#include <emscripten.h>
+// emdawnwebgpu exposes emscripten_webgpu_get_device() directly from webgpu.h
+// (no separate html5_webgpu.h header any more — that was removed in the
+// transition away from -sUSE_WEBGPU=1).
+#include <webgpu/webgpu.h>
+#define D3_WEBGPU_AVAILABLE 1
+// Embedded WGSL shaders, generated from webgpu-port/shaders/*.wgsl by
+// scripts/embed_wgsl.py. Available: kWGSL_texture, kWGSL_depth,
+// kWGSL_ambient, kWGSL_interaction.
+#include "wgsl/embedded_shaders.h"
+#else
+#define D3_WEBGPU_AVAILABLE 0
+#endif
+
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+
+#define WGPU_NOT_YET(name) do { \
+    static bool warned = false; \
+    if (!warned) { fprintf(stderr, "[WebGPU stub] %s not implemented\n", name); warned = true; } \
+} while (0)
+
+#if D3_WEBGPU_AVAILABLE
+
+// ─── Format / usage mapping helpers ─────────────────────────────────────────
+
+static WGPUTextureFormat toWGPUFormat(idGpuTextureFormat f) {
+    switch (f) {
+        case idGpuTextureFormat::R8:               return WGPUTextureFormat_R8Unorm;
+        case idGpuTextureFormat::RG8:              return WGPUTextureFormat_RG8Unorm;
+        case idGpuTextureFormat::RGBA8:            return WGPUTextureFormat_RGBA8Unorm;
+        case idGpuTextureFormat::RGBA8Srgb:        return WGPUTextureFormat_RGBA8UnormSrgb;
+        case idGpuTextureFormat::RGB10A2:          return WGPUTextureFormat_RGB10A2Unorm;
+        case idGpuTextureFormat::R11G11B10F:       return WGPUTextureFormat_RG11B10Ufloat;
+        case idGpuTextureFormat::R16F:             return WGPUTextureFormat_R16Float;
+        case idGpuTextureFormat::RGBA16F:          return WGPUTextureFormat_RGBA16Float;
+        case idGpuTextureFormat::R32F:             return WGPUTextureFormat_R32Float;
+        case idGpuTextureFormat::Depth16:          return WGPUTextureFormat_Depth16Unorm;
+        case idGpuTextureFormat::Depth24:          return WGPUTextureFormat_Depth24PlusStencil8;
+        case idGpuTextureFormat::Depth24Stencil8:  return WGPUTextureFormat_Depth24PlusStencil8;
+        case idGpuTextureFormat::Depth32F:         return WGPUTextureFormat_Depth32Float;
+        case idGpuTextureFormat::BC1:              return WGPUTextureFormat_BC1RGBAUnorm;
+        case idGpuTextureFormat::BC3:              return WGPUTextureFormat_BC3RGBAUnorm;
+        case idGpuTextureFormat::BC7:              return WGPUTextureFormat_BC7RGBAUnorm;
+        case idGpuTextureFormat::ASTC4x4:          return WGPUTextureFormat_ASTC4x4Unorm;
+        default:                                   return WGPUTextureFormat_Undefined;
+    }
+}
+
+static WGPUBufferUsage toWGPUBufferUsage(uint32_t usage) {
+    uint32_t out = 0;
+    if (usage & (uint32_t)idGpuBufferUsage::Vertex)    out |= WGPUBufferUsage_Vertex;
+    if (usage & (uint32_t)idGpuBufferUsage::Index)     out |= WGPUBufferUsage_Index;
+    if (usage & (uint32_t)idGpuBufferUsage::Uniform)   out |= WGPUBufferUsage_Uniform;
+    if (usage & (uint32_t)idGpuBufferUsage::Storage)   out |= WGPUBufferUsage_Storage;
+    if (usage & (uint32_t)idGpuBufferUsage::CopySrc)   out |= WGPUBufferUsage_CopySrc;
+    if (usage & (uint32_t)idGpuBufferUsage::CopyDst)   out |= WGPUBufferUsage_CopyDst;
+    if (usage & (uint32_t)idGpuBufferUsage::MapWrite)  out |= WGPUBufferUsage_MapWrite;
+    if (usage & (uint32_t)idGpuBufferUsage::MapRead)   out |= WGPUBufferUsage_MapRead;
+    return (WGPUBufferUsage)out;
+}
+
+static WGPUTextureUsage toWGPUTextureUsage(uint32_t usage) {
+    uint32_t out = 0;
+    if (usage & (uint32_t)idGpuTextureUsage::Sampled)      out |= WGPUTextureUsage_TextureBinding;
+    if (usage & (uint32_t)idGpuTextureUsage::Storage)      out |= WGPUTextureUsage_StorageBinding;
+    if (usage & (uint32_t)idGpuTextureUsage::RenderTarget) out |= WGPUTextureUsage_RenderAttachment;
+    if (usage & (uint32_t)idGpuTextureUsage::CopySrc)      out |= WGPUTextureUsage_CopySrc;
+    if (usage & (uint32_t)idGpuTextureUsage::CopyDst)      out |= WGPUTextureUsage_CopyDst;
+    return (WGPUTextureUsage)out;
+}
+
+#endif // D3_WEBGPU_AVAILABLE
+
+// Iter 6: per-surface record layout — mirrors WGPUInteractionRecord in
+// tr_render.cpp. Same field order + offsets so external linkage works.
+struct Rec {
+    uint32_t vertOffset, vertCount, indexOffset, indexCount;
+    uint32_t pad0, pad1, pad2, pad3;
+    uint32_t lightId, sPad1, sPad2, sPad3;
+    float modelMatrix[16];
+    float localLightOrigin[4], localViewOrigin[4];
+    float lightProjS[4], lightProjT[4], lightProjQ[4], lightFalloffS[4];
+    float diffuseColor[4], specularColor[4];
+};
+
+// Iter 7b: mirrors WGPUImageSlot in tr_render.cpp (C linkage, layout-stable).
+struct ImgSlot { const void* ptr; int w, h; uint8_t* pixels; char name[64]; int repeat; int defaulted; };
+extern "C" const ImgSlot* D3_WebGPU_LookupCachedImage(const void* img);
+// Iter 13b: mirrors WGPUCubeSlot in tr_render.cpp.
+struct CubeSlot { const void* ptr; int size; uint8_t* faces[6]; };
+extern "C" const CubeSlot* D3_WebGPU_LookupCubeImage(const void* img);
+// Iter 14: mirrors WGPUSubviewLink in tr_render.cpp.
+struct SubLink { void* img; uint32_t viewTag; };
+extern "C" SubLink g_subviewLinks[];
+extern "C" uint32_t g_subviewLinkCount;
+extern "C" const char* D3_WebGPU_ImageName(const void* imgPtr);
+extern "C" void D3_WebGPU_ReportImageCache(void);
+extern "C" uint32_t g_capBloomOn;
+extern "C" int g_capWgpuSingleLight;
+extern "C" float g_capShadowDarken;
+extern "C" float    g_capBloomThresh;
+extern "C" float    g_capBloomScale;
+extern "C" int      g_capTexBudgetMB;   // iter 28: GPU texture-cache byte budget (0 = unlimited)
+extern "C" int      g_capTexMaxDim;     // iter 28: pre-upload dimension cap (0 = uncapped)
+extern "C" uint32_t g_capDetTest;       // iter 28: determinism self-test gate
+extern "C" uint32_t g_capVertDedupCount; // iter 28: frame geometry-dedup table fill (reset on drain)
+extern "C" float    g_capBfgSpec;       // iter 29: 1 = BFG analytic specular, 0 = classic LUT
+// Iter 55: progressive texture streaming — idImage ptrs whose CPU pixels were
+// just refreshed (a streamed file arrived + the image reloaded). The backend
+// evicts these from its GPU caches at the next drain so the real texture
+// replaces the stale gray _default.
+extern "C" { extern const void* g_capReuploadPtrs[]; extern int g_capReuploadCount; extern int g_capReuploadAll; }
+// iter-132: throttled background GPU-texture pre-warm (see preloadSweep). The
+// budget mirrors r_wgpuPreloadPerFrame; the by-index accessors enumerate the
+// CPU image cache (the backend otherwise has only by-ptr lookup).
+extern "C" int g_capPreloadPerFrame;
+extern "C" int g_capPreloadMsPerFrame;
+// R0: ACES filmic tonemap grade (opt-in ?tonemap). Mirrors of r_tonemap*.
+extern "C" uint32_t g_capTonemapOn;
+extern "C" float    g_capTonemapExposure;
+extern "C" uint32_t g_capTonemapDither;
+extern "C" int D3_WebGPU_CachedImageCount( void );
+extern "C" const void* D3_WebGPU_CachedImagePtr( int i );
+
+// ─── Backend class ──────────────────────────────────────────────────────────
+
+class idRenderBackend_WebGPU : public idRenderBackend {
+public:
+    idGpuBackendKind GetKind() const override { return idGpuBackendKind::WebGPU; }
+
+    bool Init(void* /*nativeWindow*/, int w, int h) override {
+#if D3_WEBGPU_AVAILABLE
+        // The JS shell pre-acquires the WGPUDevice and stashes it in
+        // Module.preinitializedWebGPUDevice (see src/d3Runtime.js). The
+        // Emscripten WebGPU port exposes it synchronously here.
+        device = emscripten_webgpu_get_device();
+        if (!device) {
+            fprintf(stderr, "[WebGPU] emscripten_webgpu_get_device returned null.\n");
+            return false;
+        }
+        queue = wgpuDeviceGetQueue(device);
+        fprintf(stderr, "[WebGPU] device + queue acquired\n");
+
+        // Phase 5d: create a WGPUSurface on #webgpuCanvas (the
+        // side-by-side canvas added by main.js for the cutover period;
+        // the engine's GL path still owns #gameCanvas).
+        WGPUEmscriptenSurfaceSourceCanvasHTMLSelector cs = {};
+        cs.chain.sType = WGPUSType_EmscriptenSurfaceSourceCanvasHTMLSelector;
+        cs.selector = { "#webgpuCanvas", WGPU_STRLEN };
+        WGPUSurfaceDescriptor sd = {};
+        sd.nextInChain = &cs.chain;
+        // Need an instance to create a surface. Fresh instance is fine —
+        // the device was created from a different instance over in JS,
+        // but emdawnwebgpu reconciles instances for canvas surfaces.
+        WGPUInstanceDescriptor id = {};
+        WGPUInstance instance = wgpuCreateInstance(&id);
+        surface = instance ? wgpuInstanceCreateSurface(instance, &sd) : nullptr;
+        if (instance) wgpuInstanceRelease(instance);
+        if (!surface) {
+            fprintf(stderr, "[WebGPU] surface creation failed for #webgpuCanvas\n");
+            // Non-fatal: device is still acquired, resource ops still work.
+        } else {
+            // Configure the surface for rendering. Use rgba8unorm — the
+            // de facto WebGPU canvas format on iOS.
+            surfaceFormat = WGPUTextureFormat_BGRA8Unorm;
+            WGPUSurfaceConfiguration cfg = {};
+            cfg.device = device;
+            cfg.format = surfaceFormat;
+            // CopySrc: iter 16's heat haze copies the canvas into its
+            // _currentRender substitute between the final-pass halves.
+            cfg.usage = WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_CopySrc;
+            cfg.alphaMode = WGPUCompositeAlphaMode_Auto;
+            cfg.width = (uint32_t)w;
+            cfg.height = (uint32_t)h;
+            cfg.presentMode = WGPUPresentMode_Fifo;
+            wgpuSurfaceConfigure(surface, &cfg);
+            fprintf(stderr, "[WebGPU] surface configured %dx%d\n", w, h);
+
+            // Iter 5: depth attachment for proper occlusion when drawing the
+            // captured DOOM 3 surface. Depth24Plus is the minimum spec format.
+            WGPUTextureDescriptor dd = {};
+            dd.size = { (uint32_t)w, (uint32_t)h, 1 };
+            dd.mipLevelCount = 1;
+            dd.sampleCount = 1;
+            dd.dimension = WGPUTextureDimension_2D;
+            dd.format = WGPUTextureFormat_Depth24PlusStencil8;
+            dd.usage = WGPUTextureUsage_RenderAttachment;
+            dd.label = { "webgpuDepth", WGPU_STRLEN };
+            depthTexture = wgpuDeviceCreateTexture(device, &dd);
+            depthView = depthTexture ? wgpuTextureCreateView(depthTexture, nullptr) : nullptr;
+            depthW = w; depthH = h;
+        }
+        return true;
+#else
+        (void)w; (void)h;
+        fprintf(stderr, "[WebGPU] not compiled in (D3_WEBGPU_BACKEND not set)\n");
+        return false;
+#endif
+    }
+
+    void Shutdown() override {
+#if D3_WEBGPU_AVAILABLE
+        if (depthView)    { wgpuTextureViewRelease(depthView); depthView = nullptr; }
+        if (depthTexture) { wgpuTextureRelease(depthTexture); depthTexture = nullptr; }
+        if (surface) { wgpuSurfaceUnconfigure(surface); wgpuSurfaceRelease(surface); surface = nullptr; }
+        if (queue)   { wgpuQueueRelease(queue);   queue = nullptr; }
+        if (device)  { wgpuDeviceRelease(device); device = nullptr; }
+#endif
+    }
+
+    void Resize(int /*w*/, int /*h*/) override {
+        // Surface reconfiguration goes here in Phase 5b.
+    }
+
+    // ─── Frame / render pass — IMPLEMENTED (Phase 5b) ───────────────────────
+
+    void BeginFrame() override {
+#if D3_WEBGPU_AVAILABLE
+        if (!device) return;
+        if (cmdEncoder) {
+            // Stale encoder from a previous frame that wasn't submitted.
+            // Drop it; the engine will re-record this frame fresh.
+            wgpuCommandEncoderRelease(cmdEncoder);
+            cmdEncoder = nullptr;
+        }
+        WGPUCommandEncoderDescriptor cd = {};
+        cd.label = { "frame", WGPU_STRLEN };
+        cmdEncoder = wgpuDeviceCreateCommandEncoder(device, &cd);
+#endif
+    }
+
+    void EndFrame() override {
+#if D3_WEBGPU_AVAILABLE
+        // Iter 1 (Phase 5d milestone): instead of a debug clear, render a
+        // textured quad using texture.wgsl. Lazy-init the pipeline + resources
+        // on first frame. Proves the full pipeline-create + bindgroup +
+        // textured-draw path works on iOS Safari WebGPU, end-to-end, inside
+        // the engine context (not just standalone like wall.html).
+        if (surface && !demoInit) {
+            demoInit = true;
+            initDemoQuad();
+            initInteractionPipeline();
+            initDepthPipeline();
+            initPassPipelines();
