+/*
+===============
+R_ReloadStreamedImages_f
+
+Iter 55 (progressive texture streaming): re-read ONLY the images that
+currently hold the gray _default because their file was missing when first
+drawn (image_preload 0 → lazy first-Bind load). After a streaming batch writes
+the real loose files into the FS, this force-reloads just those — each Reload
+re-fires GenerateImage → D3_WebGPU_CacheImage, which records the ptr for the
+backend's per-image GPU-cache eviction. Non-defaulted images are untouched, so
+the cost is proportional to the newly-arrived textures, not the whole set.
+===============
+*/
+void R_ReloadStreamedImages_f( const idCmdArgs &args ) {
+	int reloaded = 0, stillDefault = 0;
+	for ( int i = 0 ; i < globalImages->images.Num() ; i++ ) {
+		idImage *image = globalImages->images[ i ];
+		if ( !image->defaulted || image->generatorFunction != NULL || image->isPartialImage ) {
+			continue;
+		}
+		// Clear defaulted first: if the file is STILL missing, ActuallyLoadImage
+		// re-sets it (MakeDefault) and a later batch retries; if it now loads,
+		// defaulted stays false.
+		image->defaulted = false;
+		image->Reload( false /*checkPrecompressed*/, true /*force*/ );
+		if ( image->defaulted ) stillDefault++; else reloaded++;
+	}
+	common->Printf( "[d3] reloadStreamedImages: %d reloaded, %d still missing\n", reloaded, stillDefault );
+}
