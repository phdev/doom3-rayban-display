+        // PlayerView damage-blob's _scratch — a CaptureRenderToImage target the
+        // port never echoes) falls back to TRANSPARENT, not white, so a missing
+        // dynamic overlay draws NOTHING instead of a full-screen WHITE block.
+        // Scoped to 2D records: cached static images (incl. _white) never miss,
+        // so a legitimate white HUD element still binds its real texture.
+        WGPUTextureView view = getEngineTextureView(imgPtr, clearFallback ? fbClearView : fbWhiteView);
+        WGPUBindGroupEntry e[3] = {};
+        e[0].binding = 0; e[0].buffer = passUBuf; e[0].offset = (uint64_t)slot * kUBStride; e[0].size = 128;
+        e[1].binding = 1; e[1].sampler = ( clamp && clampSampler ) ? clampSampler : demoSampler;   // iter-130
+        e[2].binding = 2; e[2].textureView = view;
+        WGPUBindGroupDescriptor bgd = {};
+        bgd.layout = passBGL;
+        bgd.entryCount = 3;
+        bgd.entries = e;
+        WGPUBindGroup g = wgpuDeviceCreateBindGroup(device, &bgd);
+        // Iter 42: EVICT, never leak. The cache key includes the record
+        // slot, so scene churn (the boot cinematic especially) permanently
+        // strands stale (slot,img) pairs; once full, the old code returned
+        // an unreleased transient per draw per frame — the iOS GPU process
+        // died of it in minutes ("device lost: destroyed" on iPhone).
+        // Round-robin replacement: the encoder holds its own reference to
+        // any in-flight group, so releasing ours here is safe.
+        uint32_t idx;
+        if (passBGCacheCount < kPassBGCacheSize) {
+            idx = passBGCacheCount++;
+        } else {
+            idx = passBGEvictCursor++ % kPassBGCacheSize;
+            if (passBGCache[idx].group) wgpuBindGroupRelease(passBGCache[idx].group);
+            if (!passBGOverflowWarned) {
+                passBGOverflowWarned = true;
+                EM_ASM({ console.info("[d3] WebGPU pass bind-group cache evicting (round-robin)"); });
+            }
+        }
+        passBGCache[idx].slot = slot;
+        passBGCache[idx].img = imgPtr;
+        passBGCache[idx].group = g;
+        return g;
+    }
+
+    // Iter 17: pass bind group sampling a per-slot cinematic frame texture.
+    // Built fresh each frame (the frame content changes every frame anyway);
+    // retired at the next drain once the prior submit completed.
+    WGPUBindGroup getCinPassBindGroup(uint32_t slot, uint32_t cin) {
+        if (cin >= kCinSlots || !cinView[cin] || !passUBuf) return nullptr;
+        WGPUBindGroupEntry e[3] = {};
+        e[0].binding = 0; e[0].buffer = passUBuf; e[0].offset = (uint64_t)slot * kUBStride; e[0].size = 128;
+        e[1].binding = 1; e[1].sampler = demoSampler;
+        e[2].binding = 2; e[2].textureView = cinView[cin];
+        WGPUBindGroupDescriptor bgd = {};
+        bgd.layout = passBGL;
+        bgd.entryCount = 3;
+        bgd.entries = e;
+        WGPUBindGroup g = wgpuDeviceCreateBindGroup(device, &bgd);
+        // park it for release at the next drain (one transient per cin slot
+        // per frame is the common case; extras replace and release eagerly)
+        if (cinFrameGroups[cin]) wgpuBindGroupRelease(cinFrameGroups[cin]);
+        cinFrameGroups[cin] = g;
+        return g;
+    }
+
+    // Iter 8b: z-fill pre-pass pipeline. No fragment stage, no color
+    // targets — writes depth only. The lit pass then tests LessEqual with
+    // depth writes off, giving correct occlusion AND letting multiple
+    // light passes of the same surface accumulate at equal depth.
+    //
+    // CRITICAL: built from interaction.wgsl's vs_main — the SAME module and
+    // entry point as the lit pipeline — so both compute bit-identical clip
+    // positions. A separate depth-only shader source risks the compiler
+    // ordering the position math differently between pipelines; a 1-ulp
+    // clip-z difference makes LessEqual reject every lit fragment (black
+    // echo). depth.wgsl stays in the tree for future true depth-only uses.
+    void initDepthPipeline() {
+        WGPUShaderSourceWGSL wgsl = {};
+        wgsl.chain.sType = WGPUSType_ShaderSourceWGSL;
+        wgsl.code = { kWGSL_interaction, WGPU_STRLEN };
+        WGPUShaderModuleDescriptor smd = {};
+        smd.nextInChain = &wgsl.chain;
+        WGPUShaderModule mod = wgpuDeviceCreateShaderModule(device, &smd);
+        if (!mod) { fprintf(stderr, "[WebGPU] prepass shader create FAILED\n"); return; }
+
+        WGPUDepthStencilState dss = {};
+            dss.stencilReadMask = 0xFFu;   // zero-init = mask 0 = inert stencil (emdawnwebgpu passes masks verbatim); 0xFF not 0xFFFFFFFF — iOS WebKit rejects out-of-format mask bits
+            dss.stencilWriteMask = 0xFFu;
+        dss.format = WGPUTextureFormat_Depth24PlusStencil8;
+        dss.depthWriteEnabled = WGPUOptionalBool_True;
+        dss.depthCompare = WGPUCompareFunction_LessEqual;
+        dss.stencilFront.compare = WGPUCompareFunction_Always;
+        dss.stencilBack.compare  = WGPUCompareFunction_Always;
+        dss.stencilFront.failOp = dss.stencilFront.depthFailOp = dss.stencilFront.passOp = WGPUStencilOperation_Keep;
+        dss.stencilBack.failOp  = dss.stencilBack.depthFailOp  = dss.stencilBack.passOp  = WGPUStencilOperation_Keep;
+
+        WGPURenderPipelineDescriptor pd = {};
+        pd.label = { "depthPrepass", WGPU_STRLEN };
+        pd.vertex.module = mod;
+        pd.vertex.entryPoint = { "vs_main", WGPU_STRLEN };
+        pd.vertex.bufferCount = 1;
+        pd.vertex.buffers = drawVertLayout();
+        pd.primitive.topology = WGPUPrimitiveTopology_TriangleList;
+        pd.primitive.cullMode = WGPUCullMode_None;
+        pd.multisample.count = 1;
+        pd.multisample.mask = 0xFFFFFFFF;
+        pd.fragment = nullptr;          // depth-only
+        pd.depthStencil = &dss;
+        depthPipeline = wgpuDeviceCreateRenderPipeline(device, &pd);
+        wgpuShaderModuleRelease(mod);
+        if (!depthPipeline) { fprintf(stderr, "[WebGPU] depth pipeline FAILED\n"); return; }
+    }
+
+    // Iter 7b: small procedural texture helper (fallbacks for images that
+    // aren't in the CPU cache).
+    WGPUTextureView makeFillTex(uint32_t fill, const char* label) {
+        const int M = 4;
+        uint32_t pixels[M*M];
+        for (int i = 0; i < M*M; ++i) pixels[i] = fill;
+        WGPUTextureDescriptor td = {};
+        td.size = { (uint32_t)M, (uint32_t)M, 1 };
+        td.mipLevelCount = 1;
+        td.sampleCount = 1;
+        td.dimension = WGPUTextureDimension_2D;
+        td.format = WGPUTextureFormat_RGBA8Unorm;
+        td.usage = WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst;
+        td.label = { label, WGPU_STRLEN };
+        WGPUTexture tex = wgpuDeviceCreateTexture(device, &td);
+        WGPUTexelCopyTextureInfo dst = {};
+        dst.texture = tex;
+        WGPUTexelCopyBufferLayout layout = {};
+        layout.bytesPerRow = M * 4; layout.rowsPerImage = M;
+        WGPUExtent3D extent = { (uint32_t)M, (uint32_t)M, 1 };
+        wgpuQueueWriteTexture(queue, &dst, pixels, sizeof(pixels), &layout, &extent);
+        // Texture handle intentionally not stored — lives for the session.
+        return wgpuTextureCreateView(tex, nullptr);
+    }
+
+    // Names an unresolvable image once — turns "flat tinted quad" reports
+    // into an actionable image list (helper lives in tr_render.cpp).
+    void noteImageFallback(const void* imgPtr, const char* why) {
+        static const void* seen[24] = {};
+        static int seenCount = 0;
+        for (int i = 0; i < seenCount; ++i) if (seen[i] == imgPtr) return;
+        if (seenCount >= 24) return;
+        seen[seenCount++] = imgPtr;
+        EM_ASM_({ console.info("[d3] WebGPU image FALLBACK (" + UTF8ToString($1) + "): " + UTF8ToString($0)); },
+                D3_WebGPU_ImageName(imgPtr), why);
+    }
+
+    // 2x box reduction (shared by the mip chain and the iter-28 pre-reduce).
+    static void boxReduceHalf(const uint8_t* src, int lw, int lh, uint8_t* dst, int nw, int nh) {
+        for (int y = 0; y < nh; ++y) {
+            const int sy0 = y * 2, sy1 = (sy0 + 1 < lh) ? sy0 + 1 : sy0;
+            for (int x = 0; x < nw; ++x) {
+                const int sx0 = x * 2, sx1 = (sx0 + 1 < lw) ? sx0 + 1 : sx0;
+                for (int c = 0; c < 4; ++c) {
+                    const int sum = src[(sy0*lw+sx0)*4+c] + src[(sy0*lw+sx1)*4+c]
+                                  + src[(sy1*lw+sx0)*4+c] + src[(sy1*lw+sx1)*4+c];
+                    dst[(y*nw+x)*4+c] = (uint8_t)(sum >> 2);
+                }
+            }
+        }
+    }
+
+    // Iter 28: surface the GPU texture footprint to JS — the diag stats line
+    // persists it via crash telemetry, so a dead iOS tab now reports exactly
+    // how much WebGPU texture memory it held.
+    void publishTexStats() {
+        EM_ASM_({
+            window.__d3WgpuTexN = $0;
+            window.__d3WgpuTexMB = $1;
+            window.__d3WgpuTexDrop = $2;
+        }, texCacheCount, (double)gpuTexBytes / (1024.0 * 1024.0), gpuTexDropped);
+    }
+
+    // Iter 55: drop GPU caches for images whose CPU pixels just changed (a
+    // streamed texture arrived → reloaded → re-cached). Per-image eviction
+    // keeps the cost proportional to the newly-arrived textures (NOT a full
+    // re-upload, which would re-trigger the iter-30 WebKit GPU-process churn).
+    // The evicted entries lazily rebuild from the fresh CPU pixels when next
+    // drawn; lastMatGroups[] self-heal next drain (rebuilt from matCache).
+    void processStreamReuploads() {
+        if (g_capReuploadAll) {
+            for (int i = 0; i < texCacheCount; ++i)
+                if (texCache[i].view) wgpuTextureViewRelease(texCache[i].view);
+            texCacheCount = 0; gpuTexBytes = 0;
+            for (int i = 0; i < matCacheCount; ++i)
+                if (matCache[i].group) wgpuBindGroupRelease(matCache[i].group);
+            matCacheCount = 0;
+            g_capReuploadAll = 0;
+            g_capReuploadCount = 0;
+            return;
+        }
+        for (int k = 0; k < g_capReuploadCount; ++k) {
+            const void* ptr = g_capReuploadPtrs[k];
+            for (int i = matCacheCount - 1; i >= 0; --i) {
+                bool hit = false;
+                for (int j = 0; j < 5; ++j) if (matCache[i].key[j] == ptr) { hit = true; break; }
+                if (hit) {
+                    if (matCache[i].group) wgpuBindGroupRelease(matCache[i].group);
+                    matCache[i] = matCache[matCacheCount - 1];
+                    matCache[matCacheCount - 1] = MatCacheEntry{};
+                    matCacheCount--;
+                }
+            }
+            for (int i = texCacheCount - 1; i >= 0; --i) {
+                if (texCache[i].ptr == ptr) {
+                    if (texCache[i].view) wgpuTextureViewRelease(texCache[i].view);
+                    gpuTexBytes -= texCache[i].bytes;
+                    texCache[i] = texCache[texCacheCount - 1];
+                    texCache[texCacheCount - 1] = TexCacheEntry{};
+                    texCacheCount--;
+                    break;  // at most one texCache entry per ptr
+                }
+            }
+        }
+        g_capReuploadCount = 0;
+    }
+
+    // Iter 7b: GPU mirror of the engine's CPU image cache. One texture per
+    // idImage pointer, created+uploaded on first use.
+    WGPUTextureView getEngineTextureView(const void* imgPtr, WGPUTextureView fallback) {
+        if (!imgPtr) return fallback;
+        // Iter 14: linked subview render targets shadow the engine image.
+        for (uint32_t i = 0; i < g_subviewLinkCount && i < kMaxSubviews; ++i) {
+            if (g_subviewLinks[i].img == imgPtr && subviewView[i]) return subviewView[i];
+        }
+        for (int i = 0; i < texCacheCount; ++i) {
+            if (texCache[i].ptr == imgPtr) return texCache[i].view;
+        }
+        const ImgSlot* slot = D3_WebGPU_LookupCachedImage(imgPtr);
+        if (!slot || !slot->pixels || slot->w <= 0 || slot->h <= 0) { noteImageFallback(imgPtr, "cpu-miss"); return fallback; }
+        // Iter 55: a streamed texture not yet arrived is cached as the gray
+        // _default — use the caller's role-aware neutral fallback (flat normal /
+        // checker diffuse / white spec) instead, so the surface renders gray-lit
+        // rather than black (a defaulted normal map would otherwise decode to
+        // garbage normals and collapse N·L). Reload swaps in the real pixels.
+        if (slot->defaulted) { return fallback; }
+        if (texCacheCount >= (int)kTexCacheSize) { noteImageFallback(imgPtr, "gpu-cache-full"); return fallback; }
+
+        // Level 0 from the cache.
+        int lw = slot->w, lh = slot->h;
+        uint8_t* cur = (uint8_t*)malloc((size_t)lw * lh * 4u);
+        memcpy(cur, slot->pixels, (size_t)lw * lh * 4u);
+
+        // Iter 28: pre-reduce oversized images (r_wgpuTexMaxDim) before any
+        // GPU allocation — the phone profile caps at 128 to match its
+        // image_downSizeLimit, quartering the cost of the >128 entries
+        // (injected lights/, GUI art the reducer left at 256).
+        while (g_capTexMaxDim > 0 && (lw > g_capTexMaxDim || lh > g_capTexMaxDim)) {
+            const int nw = lw > 1 ? lw >> 1 : 1, nh = lh > 1 ? lh >> 1 : 1;
+            uint8_t* next = (uint8_t*)malloc((size_t)nw * nh * 4u);
+            boxReduceHalf(cur, lw, lh, next, nw, nh);
+            free(cur);
+            cur = next;
+            lw = nw; lh = nh;
+            if (lw <= 1 && lh <= 1) break;
+        }
+
+        // Full mip chain (box filter) — single-mip textures shimmer badly
+        // under minification at the echo's render scale.
+        uint32_t mips = 1;
+        { int m = lw > lh ? lw : lh; while (m > 1) { m >>= 1; mips++; } }
+
+        // Iter 28: GPU byte budget (r_wgpuTexBudgetMB). iOS Safari kills the
+        // whole tab when total GPU memory tips over — an over-budget image
+        // binding a fallback is an artifact, not a crash.
+        size_t newBytes = 0;
+        { int w = lw, h = lh; for (uint32_t l = 0; l < mips; ++l) { newBytes += (size_t)w * h * 4u; w = w > 1 ? w >> 1 : 1; h = h > 1 ? h >> 1 : 1; } }
+        if (g_capTexBudgetMB > 0 && gpuTexBytes + newBytes > ((size_t)g_capTexBudgetMB << 20)) {
+            free(cur);
+            gpuTexDropped++;
+            publishTexStats();
+            noteImageFallback(imgPtr, "gpu-budget");
+            return fallback;
+        }
+
+        WGPUTextureDescriptor td = {};
+        td.size = { (uint32_t)lw, (uint32_t)lh, 1 };
+        td.mipLevelCount = mips;
+        td.sampleCount = 1;
+        td.dimension = WGPUTextureDimension_2D;
+        td.format = WGPUTextureFormat_RGBA8Unorm;
+        td.usage = WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst;
+        WGPUTexture tex = wgpuDeviceCreateTexture(device, &td);
+        if (!tex) { free(cur); return fallback; }
+
+        // Successive 2x box reductions per mip level.
+        for (uint32_t level = 0; level < mips; ++level) {
+            WGPUTexelCopyTextureInfo dst = {};
+            dst.texture = tex;
+            dst.mipLevel = level;
+            WGPUTexelCopyBufferLayout layout = {};
+            layout.bytesPerRow = (uint32_t)lw * 4u;
+            layout.rowsPerImage = (uint32_t)lh;
+            WGPUExtent3D extent = { (uint32_t)lw, (uint32_t)lh, 1 };
+            wgpuQueueWriteTexture(queue, &dst, cur, (size_t)lw * lh * 4u, &layout, &extent);
+            if (level + 1 >= mips) break;
+            const int nw = lw > 1 ? lw >> 1 : 1, nh = lh > 1 ? lh >> 1 : 1;
+            uint8_t* next = (uint8_t*)malloc((size_t)nw * nh * 4u);
+            boxReduceHalf(cur, lw, lh, next, nw, nh);
+            // Iter 33: zeroClamp images carry a baked black border (vanilla's
+            // border-clamp substitute) — re-stamp it per mip level or the box
+            // filter averages it away and edge-clamp smears the cookie again.
+            if (slot->repeat == 3 || slot->repeat == 4) {
+                const bool alphaMode = (slot->repeat == 4);
+                const uint8_t br = alphaMode ? 255 : 0, ba = alphaMode ? 0 : 255;
+                for (int x = 0; x < nw; ++x) {
+                    uint8_t* t = next + (size_t)x * 4u;            // top row
+                    uint8_t* b = next + ((size_t)(nh - 1) * nw + x) * 4u;
+                    t[0] = t[1] = t[2] = br; t[3] = ba;
+                    b[0] = b[1] = b[2] = br; b[3] = ba;
+                }
+                for (int y = 0; y < nh; ++y) {
+                    uint8_t* l = next + (size_t)y * nw * 4u;       // left col
+                    uint8_t* r2 = next + ((size_t)y * nw + (nw - 1)) * 4u;
+                    l[0] = l[1] = l[2] = br; l[3] = ba;
+                    r2[0] = r2[1] = r2[2] = br; r2[3] = ba;
+                }
+            }
+            free(cur);
+            cur = next;
+            lw = nw; lh = nh;
+        }
+        free(cur);
+        WGPUTextureView view = wgpuTextureCreateView(tex, nullptr);
+        // The view holds its own ref to the texture; release our creating
+        // handle so a later wgpuTextureViewRelease (iter-55 streaming evict)
+        // actually frees the texture instead of leaking it.
+        wgpuTextureRelease(tex);
+        texCache[texCacheCount].ptr = imgPtr;
+        texCache[texCacheCount].view = view;
+        texCache[texCacheCount].bytes = newBytes;
+        texCacheCount++;
+        gpuTexBytes += newBytes;
+        publishTexStats();
+        // Diagnostic inventory: name, size, mid-pixel RGBA (first 12 uploads
+        // only — enough to validate the cache without flooding the console).
+        if (texCacheCount <= 12) {
+            const int mx = slot->w / 2, my = slot->h / 2;
+            const uint8_t* p = slot->pixels + ((size_t)my * slot->w + mx) * 4u;
+            EM_ASM_({
+                console.info("[d3] texUpload '" + UTF8ToString($0) + "' " + $1 + "x" + $2 +
+                             " mid=(" + $3 + "," + $4 + "," + $5 + "," + $6 + ")");
+            }, slot->name, slot->w, slot->h, p[0], p[1], p[2], p[3]);
+        }
+        return view;
+    }
+
+    // iter-132: throttled background GPU-texture pre-warm. With image_preload 0
+    // (the wearable/glasses profile) the level's textures are CPU-decoded at
+    // EndLevelLoad but each GPU texture is created lazily on first DRAW in
+    // getEngineTextureView above — an unthrottled per-view burst (box-filter mip
+    // chain + writeTexture) that reads black-until-decoded on the weak glasses
+    // GPU. This sweep pre-creates them N/frame over the ALREADY-decoded CPU image
+    // cache, so the level fully textures in ~1-3s smoothly. It calls only
+    // getEngineTextureView — NO new CPU decode (the cache is already populated),
+    // so it cannot re-trigger the iter-79 decode flood; the full enpro set is
+    // ~62.5MB < the 80MB budget at the 96px tier, so the no-LRU budget never
+    // trips. Visible textures keep priority (the lazy-on-Bind path is unchanged;
+    // this only fills the off-screen remainder so looking around no longer
+    // stalls). Off unless r_wgpuPreloadPerFrame > 0. Placed after the iter-30
+    // submit-skip so each warmed batch is flushed by this frame's QueueSubmit.
+    void preloadSweep() {
+        if ( g_capPreloadPerFrame <= 0 ) return;
+        const int total = D3_WebGPU_CachedImageCount();
+        if ( preloadCursor >= total ) {
+            if ( total <= preloadSeenCount ) return;   // caught up; nothing new decoded
+            preloadCursor = preloadSeenCount;          // warm only the freshly-decoded tail
+        }
+        // Soft cap: never spend the last of the GPU budget pre-warming off-screen
+        // images — a visible texture must still be able to allocate. (Won't
+        // trigger at the 96px tier; defends ?hd / a mis-estimate against the
+        // no-LRU budget's permanent fallback-to-black.)
+        const size_t softCap = ( g_capTexBudgetMB > 0 )
+            ? ( ( (size_t)g_capTexBudgetMB << 20 ) / 10u ) * 9u
+            : (size_t)-1;
+        const double t0 = emscripten_get_now();
+        int made = 0;
+        while ( preloadCursor < total && made < g_capPreloadPerFrame ) {
+            if ( gpuTexBytes >= softCap ) { preloadCursor = total; break; }
+            const void* ptr = D3_WebGPU_CachedImagePtr( preloadCursor++ );
+            if ( !ptr ) continue;
+            const int before = texCacheCount;
+            getEngineTextureView( ptr, fbWhiteView );  // creates+caches if decodable; self-skips cached/defaulted
+            if ( texCacheCount > before ) {
+                ++made;
+                if ( g_capPreloadMsPerFrame > 0 &&
+                     emscripten_get_now() - t0 >= (double)g_capPreloadMsPerFrame ) break;
+            }
+        }
+        if ( preloadCursor >= total ) preloadSeenCount = total;
+        if ( made > 0 ) {
+            EM_ASM_({ window.__d3PreloadWarm = $0; window.__d3PreloadTotal = $1; }, texCacheCount, total);
+            // Log "complete" each time the cursor catches up to a LARGER cache than
+            // last reported — the boot-HUD images cache first (tiny total) and
+            // EndLevelLoad fills the cache to the full set moments later, so a plain
+            // once-only flag would report the premature boot total, not the real one.
+            if ( preloadCursor >= total && total > preloadLoggedTotal ) {
+                EM_ASM_({ console.info("[d3] WebGPU texture pre-warm complete: " + $0 + " of " + $1 + " GPU textures cached"); }, texCacheCount, total);
+                preloadLoggedTotal = total;
+            }
+        }
+    }
+
+    // Iter 7b: material bind group (@group(1)) per unique 5-image tuple.
+    // imgs order matches the capture in draw_arb2.cpp:
+    //   [0]=bump [1]=lightFalloff [2]=lightProj [3]=diffuse [4]=specular
+    WGPUBindGroup getMaterialBindGroup(void* const imgs[5]) {
+        // Iter 71 debug: r_wgpuSingleLight -870/-871 force the light sampler to
+        // WRAP instead of ClampToEdge — a Dawn run can then simulate the WebKit
+        // falloff-bleed that makes the enpro orange lights wash should-be-dark
+        // panels (WebKit appears not to honor ClampToEdge on this LOD-0 light
+        // sampler). The bind group cache keys on image pointers only, so flush
+        // it whenever this debug state toggles or stale clamp-sampler groups
+        // would survive the switch.
+        extern int g_capWgpuSingleLight;
+        const bool dbgFalloffWrap = (g_capWgpuSingleLight == -870 || g_capWgpuSingleLight == -871);
+        static bool s_lastDbgFalloffWrap = false;
+        if (dbgFalloffWrap != s_lastDbgFalloffWrap) {
+            for (int i = 0; i < matCacheCount; ++i) {
+                if (matCache[i].group) wgpuBindGroupRelease(matCache[i].group);
+            }
+            matCacheCount = 0;
+            s_lastDbgFalloffWrap = dbgFalloffWrap;
+        }
+        for (int i = 0; i < matCacheCount; ++i) {
+            if (memcmp(matCache[i].key, imgs, sizeof(void*) * 5) == 0) {
+                return matCache[i].group;
+            }
+        }
+        WGPUTextureView vNormal   = getEngineTextureView(imgs[0], fbFlatNormalView);
+        WGPUTextureView vFalloff  = getEngineTextureView(imgs[1], fbWhiteView);
+        WGPUTextureView vProj     = getEngineTextureView(imgs[2], fbWhiteView);
+        WGPUTextureView vDiffuse  = getEngineTextureView(imgs[3], fbCheckerView);
+        WGPUTextureView vSpecular = getEngineTextureView(imgs[4], fbWhiteView);
+        extern void* g_capSpecLUTPtr;
+        WGPUTextureView vSpecLUT  = getEngineTextureView(g_capSpecLUTPtr, fbWhiteView);
+        // Diagnostic: per-slot fallback misses. A falloff miss = the light
+        // extends forever along its axis (falloff=1) — giant washes.
+        {
+            const bool miss[5] = {
+                vNormal == fbFlatNormalView && imgs[0] != nullptr,
+                vFalloff == fbWhiteView     && imgs[1] != nullptr,
+                vProj == fbWhiteView        && imgs[2] != nullptr,
+                vDiffuse == fbCheckerView   && imgs[3] != nullptr,
+                vSpecular == fbWhiteView    && imgs[4] != nullptr,
+            };
+            // Boot-speed (iter 61): with texture streaming every gray surface is
+            // a "miss" until its texture lands, so frame 1 floods hundreds of
+            // these — each EM_ASM is a wasm→JS crossing. Cap the diagnostic to
+            // the first 30 (enough to flag a genuine data gap; the streaming
+            // settle is expected to miss).
+            static int s_missLogged = 0;
+            if ((miss[0] || miss[1] || miss[2] || miss[3] || miss[4]) && s_missLogged < 30) {
+                s_missLogged++;
+                EM_ASM_({
+                    console.info("[d3] matGroup MISS bump=" + $0 + " falloff=" + $1 +
+                                 " proj=" + $2 + " diffuse=" + $3 + " specular=" + $4);
+                }, (int)miss[0], (int)miss[1], (int)miss[2], (int)miss[3], (int)miss[4]);
+            }
+        }
+
+        WGPUBindGroupLayout bgl = wgpuRenderPipelineGetBindGroupLayout(interactionPipeline, 1);
+        // Scrolling light projections (lights/cloudscroll*: 'translate time')
+        // grow their texcoords unboundedly and MUST wrap — the single
+        // clamp-to-edge light sampler pinned them to the texture edge after
+        // ~30s of map time, silently killing those lights (the X360-vs-ours
+        // missing hangar floor pool + black marine). Honor the image's
+        // repeat mode for the projection; zeroClamp cookies keep clamp
+        // (WebGPU has no border color; edge-black cookies are equivalent).
+        const ImgSlot* projSlot = D3_WebGPU_LookupCachedImage(imgs[2]);
+        const bool projRepeats = projSlot && projSlot->repeat == 0;   // TR_REPEAT
+        WGPUBindGroupEntry e[8] = {};
+        e[0].binding = 0; e[0].sampler = interactionMaterialSampler;
+        // Iter 33: both lighting-sampler variants are LOD-0 only (vanilla
+        // GL_LINEAR semantics) — repeat cookies (scrolling lights) get the
+        // wrap LOD-0 sampler, NOT the mipped material sampler.
+        e[1].binding = 1; e[1].sampler = (projRepeats || dbgFalloffWrap) ? interactionLightWrapSampler : interactionLightSampler;
+        e[2].binding = 2; e[2].textureView = vNormal;
+        e[3].binding = 3; e[3].textureView = vSpecular;
+        e[4].binding = 4; e[4].textureView = vDiffuse;
+        e[5].binding = 5; e[5].textureView = vFalloff;
+        e[6].binding = 6; e[6].textureView = vProj;
+        e[7].binding = 7; e[7].textureView = vSpecLUT;
+        WGPUBindGroupDescriptor bgd = {};
+        bgd.layout = bgl;
+        bgd.entryCount = 8;
+        bgd.entries = e;
+        WGPUBindGroup group = wgpuDeviceCreateBindGroup(device, &bgd);
+        wgpuBindGroupLayoutRelease(bgl);
+        // Iter 42: evict round-robin instead of leaking (see getPassBindGroup).
+        int midx;
+        if (matCacheCount < (int)kMatCacheSize) {
+            midx = matCacheCount++;
+        } else {
+            midx = (int)(matEvictCursor++ % kMatCacheSize);
+            if (matCache[midx].group) wgpuBindGroupRelease(matCache[midx].group);
+            if (!matCacheOverflowWarned) {
+                matCacheOverflowWarned = true;
+                EM_ASM({ console.info("[d3] WebGPU material bind-group cache evicting (round-robin)"); });
+            }
+        }
+        memcpy(matCache[midx].key, imgs, sizeof(void*) * 5);
+        matCache[midx].group = group;
+        return group;
+    }
+
+    // Iter 7b: per-record slot resources. Each slot gets one 224-byte
+    // uniform buffer plus TWO group(0) bind groups over it: one for the
+    // interaction pipeline's layout, one for the depth pre-pass pipeline's
+    // layout (depth.wgsl only declares the mat4, so its auto layout has a
+    // smaller minBindingSize — entry.size 224 satisfies both). Fallback
+    // texture views are created here too.
+    void initRecordSlots() {
+        if (recordSlotsReady) return;
+        if (!interactionPipeline || !depthPipeline) return;
+
+        // Standard tangent-space flat normal (0,0,1) = RGB(128,128,255).
+        // Little-endian RGBA8 bytes R=0x80 G=0x80 B=0xFF A=0xFF.
+        fbFlatNormalView = makeFillTex(0xffff8080u, "fbFlatNormal");
+        fbWhiteView      = makeFillTex(0xffffffffu, "fbWhite");
+        fbClearView      = makeFillTex(0x00000000u, "fbClear");   // iter-121 Bug C: transparent fallback for missing 2D dynamic overlays
+        fbCheckerView    = makeFillTex(0xff80c080u, "fbChecker");
+
+        WGPUBindGroupLayout bglInteraction = wgpuRenderPipelineGetBindGroupLayout(interactionPipeline, 0);
+        WGPUBindGroupLayout bglDepth       = wgpuRenderPipelineGetBindGroupLayout(depthPipeline, 0);
+        // Iter 28: one consolidated buffer per family; bind groups address
+        // their slot at a static 256B-stride offset (no dynamic offsets).
+        {
+            WGPUBufferDescriptor bd = {};
+            bd.size = (uint64_t)kMaxRecordSlots * kUBStride;
+            bd.usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst | WGPUBufferUsage_CopySrc;   // CopySrc: -898 readback probe
+            bd.label = { "passUBuf", WGPU_STRLEN };
+            passUBuf = wgpuDeviceCreateBuffer(device, &bd);
+            bd.label = { "recordUBuf", WGPU_STRLEN };
+            recordUBuf = wgpuDeviceCreateBuffer(device, &bd);
+            if (shadowBGL) {
+                bd.label = { "shadowUBuf", WGPU_STRLEN };
+                shadowUBuf = wgpuDeviceCreateBuffer(device, &bd);
+            }
+        }
+        for (uint32_t i = 0; i < kMaxRecordSlots; ++i) {
+            // Iter 9: per-slot shadow uniform view (mvp + light origin = 80B)
+            if (shadowBGL) {
+                WGPUBindGroupEntry se = {};
+                se.binding = 0; se.buffer = shadowUBuf; se.offset = (uint64_t)i * kUBStride; se.size = 80;
+                WGPUBindGroupDescriptor sgd = {};
+                sgd.layout = shadowBGL;
+                sgd.entryCount = 1;
+                sgd.entries = &se;
+                shadowBindGroups[i] = wgpuDeviceCreateBindGroup(device, &sgd);
+            }
+
+            WGPUBindGroupEntry e = {};
+            e.binding = 0; e.buffer = recordUBuf; e.offset = (uint64_t)i * kUBStride; e.size = 224;
+            WGPUBindGroupDescriptor bgd = {};
+            bgd.entryCount = 1;
+            bgd.entries = &e;
+            bgd.layout = bglInteraction;
+            recordBindGroups[i] = wgpuDeviceCreateBindGroup(device, &bgd);
+            bgd.layout = bglDepth;
+            recordDepthBindGroups[i] = wgpuDeviceCreateBindGroup(device, &bgd);
+            // Iter 81: same depth layout but over passUBuf (the pass records'
+            // uniforms). MVP is at offset 0 in both UBOs, which is all the
+            // shared interaction vs_main reads for clip position — so this
+            // fills correct depth for opaque material pass records.
+            WGPUBindGroupEntry pe = {};
+            pe.binding = 0; pe.buffer = passUBuf; pe.offset = (uint64_t)i * kUBStride; pe.size = 224;
+            WGPUBindGroupDescriptor pbgd = {};
+            pbgd.entryCount = 1; pbgd.entries = &pe; pbgd.layout = bglDepth;
+            passDepthBindGroups[i] = wgpuDeviceCreateBindGroup(device, &pbgd);
+        }
+        wgpuBindGroupLayoutRelease(bglInteraction);
+        wgpuBindGroupLayoutRelease(bglDepth);
+        recordSlotsReady = true;
+        EM_ASM_({ console.info("[d3] WebGPU record slots ready: " + $0); }, kMaxRecordSlots);
+    }
+
+    // Iter 45: per-record scissor from the GL path (stored in
+    // lightFalloffS for non-reflect pass records). GL scissor origin is
+    // bottom-left; WebGPU framebuffer origin is top-left — flip Y. Records
+    // without a usable rect (or reflect records, pad3==3) get full-canvas.
+    void setRecordScissor(WGPURenderPassEncoder rp, const Rec& r) {
+        const uint32_t W = (uint32_t)depthW, H = (uint32_t)depthH;
+        if (r.pad3 == 3u) { wgpuRenderPassEncoderSetScissorRect(rp, 0, 0, W, H); return; }
+        float fx = r.lightFalloffS[0], fy = r.lightFalloffS[1];
+        float fw = r.lightFalloffS[2], fh = r.lightFalloffS[3];
+        if (fw <= 0.0f || fh <= 0.0f) { wgpuRenderPassEncoderSetScissorRect(rp, 0, 0, W, H); return; }
+        int x = (int)fx, w = (int)fw, h = (int)fh;
+        int yTop = (int)H - ((int)fy + h);
+        if (x < 0) { w += x; x = 0; }
+        if (yTop < 0) { h += yTop; yTop = 0; }
+        if (x + w > (int)W) w = (int)W - x;
+        if (yTop + h > (int)H) h = (int)H - yTop;
+        if (w <= 0 || h <= 0) { wgpuRenderPassEncoderSetScissorRect(rp, 0, 0, W, H); return; }
+        wgpuRenderPassEncoderSetScissorRect(rp, (uint32_t)x, (uint32_t)yTop, (uint32_t)w, (uint32_t)h);
+    }
+
+    // Iter 30: upload only the 256KB chunks that changed since the last
+    // frame. Re-uploading the full accumulators every frame (~12MB) made
+    // WebKit's GPU helper process balloon (measured >1.6GB on Mac Safari —
+    // iOS jetsam-kills the tab far earlier); static world geometry
+    // dominates the accumulator, so chunk-diffing against a CPU mirror
+    // cuts the staging churn ~10x. `fresh` forces a full upload (the GPU
+    // buffer was just recreated).
+    void deltaUpload(WGPUBuffer buf, const uint8_t* data, uint32_t bytes,
+                     uint8_t*& mirror, uint32_t& mirrorBytes, uint32_t& mirrorCap,
+                     bool fresh) {
+        const uint32_t kChunk = 256 * 1024;
+        if (!buf || bytes == 0) return;
+        if (mirrorCap < bytes) {
+            uint8_t* nm = (uint8_t*)realloc(mirror, bytes);
+            if (!nm) {   // mirror OOM: plain full upload, drop the mirror
+                free(mirror); mirror = nullptr; mirrorBytes = mirrorCap = 0;
+                wgpuQueueWriteBuffer(queue, buf, 0, data, bytes);
+                return;
+            }
+            mirror = nm; mirrorCap = bytes;
+        }
+        if (fresh || mirrorBytes == 0) {
+            memcpy(mirror, data, bytes);
+            mirrorBytes = bytes;
+            wgpuQueueWriteBuffer(queue, buf, 0, data, bytes);
+            return;
+        }
+        const uint32_t cmpEnd = bytes < mirrorBytes ? bytes : mirrorBytes;
+        uint32_t dbgUploaded = 0;
+        uint32_t off = 0;
+        while (off < cmpEnd) {
+            const uint32_t len = (cmpEnd - off > kChunk) ? kChunk : cmpEnd - off;
+            if (memcmp(mirror + off, data + off, len) != 0) {
+                const uint32_t start = off;
+                off += len;
+                while (off < cmpEnd) {
+                    const uint32_t l2 = (cmpEnd - off > kChunk) ? kChunk : cmpEnd - off;
+                    if (memcmp(mirror + off, data + off, l2) == 0) break;
+                    off += l2;
+                }
+                memcpy(mirror + start, data + start, off - start);
+                wgpuQueueWriteBuffer(queue, buf, start, data + start, off - start);
+                dbgUploaded += off - start;
+            } else {
+                off += len;
+            }
+        }
+        if (bytes > mirrorBytes) {   // grown tail is always new content
+            memcpy(mirror + mirrorBytes, data + mirrorBytes, bytes - mirrorBytes);
+            wgpuQueueWriteBuffer(queue, buf, mirrorBytes, data + mirrorBytes, bytes - mirrorBytes);
+            dbgUploaded += bytes - mirrorBytes;
+        }
+        {
+            extern int g_capWgpuSingleLight;
+            if (g_capWgpuSingleLight == -895 && buf == recordVertexBuf) {
+                char dl[160];
+                snprintf(dl, sizeof(dl), "dU bytes=%u mirrorBytes=%u uploaded=%u cap=%u",
+                         bytes, mirrorBytes, dbgUploaded, recordVertexCap);
+                EM_ASM_({ console.info("[d3] " + UTF8ToString($0)); }, dl);
+            }
+        }
+        mirrorBytes = bytes;
+    }
+
+    // Iter 6.6: copy CPU-side records → GPU buffers and CONSUME the
+    // accumulator (the engine appends across all of a frame's views; we
+    // drain here so a later RB_BeginDrawingView can't wipe records before
+    // we read them). When no fresh records exist this call, redraw the
+    // previous frame's set — the GPU buffers and uniforms are still valid
+    // (only happens on frames with no 3D view, where the camera can't move).
+    bool uploadCapturedRecords(uint32_t& outCount) {
+        extern Rec g_capRecords[];
+        extern uint8_t  g_capVertsAccum[];
+        extern uint16_t g_capIndexesAccum[];
+        extern uint32_t g_capRecordCount;
+        extern uint32_t g_capVertBytes;
+        extern uint32_t g_capIndexBytes;
+        extern uint32_t g_capFrameId;
+        extern uint32_t g_capDropped;
+        extern void* g_capImagePtrs[][5];
+
+        outCount = 0;
+        if (g_capRecordCount == 0) {
+            extern uint32_t g_passRecordCount;
+            extern uint32_t g_shadowRecordCount;
+            if (g_passRecordCount == 0 && g_shadowRecordCount == 0) {
+                // Truly nothing fresh — keep showing last frame's records
+                // (EndFrame's submit-skip usually prevents even reaching
+                // here; this remains for surfaces-pending edge cases).
+                outCount = lastRecordCount;
+                return lastRecordCount > 0;
+            }
+            // Iter 35: ZERO lit records but emissive/pass or shadow content
+            // is LIVE (pitch-dark scenes with glowing surfaces,
+            // r_singleLight with the light out of view). The old early
+            // return froze the entire canvas on the stale last frame while
+            // GL kept rendering the emissives. Fall through to a normal
+            // drain with an empty interaction set so passes stay live.
+        }
+
+        // Iter 28: fresh drain — slots written below land in the CPU stages;
+        // one writeBuffer per family flushes them at the end of this drain.
+        recordUBHigh = passUBHigh = shadowUBHigh = 0;
+
+        const uint32_t vNeed = (g_capVertBytes + 3u) & ~3u;
+        const uint32_t iNeed = (g_capIndexBytes + 3u) & ~3u;
+        bool vertBufFresh = false, idxBufFresh = false;
+        if (vNeed > recordVertexCap) {
+            if (recordVertexBuf) wgpuBufferRelease(recordVertexBuf);
+            uint32_t cap = vNeed; if (cap < 256*1024) cap = 256*1024;
+            WGPUBufferDescriptor d = {};
+            d.size = cap;
+            d.usage = WGPUBufferUsage_Vertex | WGPUBufferUsage_CopyDst | WGPUBufferUsage_CopySrc;
+            recordVertexBuf = wgpuDeviceCreateBuffer(device, &d);
+            recordVertexCap = cap;
+            vertBufFresh = true;
+        }
+        if (iNeed > recordIndexCap) {
+            if (recordIndexBuf) wgpuBufferRelease(recordIndexBuf);
+            uint32_t cap = iNeed; if (cap < 64*1024) cap = 64*1024;
+            WGPUBufferDescriptor d = {};
+            d.size = cap;
+            d.usage = WGPUBufferUsage_Index | WGPUBufferUsage_CopyDst;
+            recordIndexBuf = wgpuDeviceCreateBuffer(device, &d);
+            recordIndexCap = cap;
+            idxBufFresh = true;
+        }
+        if (!recordVertexBuf || !recordIndexBuf) return false;
+        {
+            extern int g_capWgpuSingleLight;
+            if (g_capWgpuSingleLight == -896) vertBufFresh = true;   // debug: force full upload
+        }
+        deltaUpload(recordVertexBuf, g_capVertsAccum, vNeed,
+                    vertMirror, vertMirrorBytes, vertMirrorCap, vertBufFresh);
+        deltaUpload(recordIndexBuf, (const uint8_t*)g_capIndexesAccum, iNeed,
+                    idxMirror, idxMirrorBytes, idxMirrorCap, idxBufFresh);
+
+        uint32_t total = (g_capRecordCount < kMaxRecordSlots) ? g_capRecordCount : kMaxRecordSlots;
+        // Keep only the MAIN view's records. Subviews (mirrors, security
+        // monitors) render FIRST in idTech4, so the last record's view tag
+        // identifies the main view; records from other views would draw
+        // ghost geometry with alien projections. Compact in place.
+        uint32_t n = 0;
+        uint32_t mainN = 0;
+        subGroupCount = 0;
+        if (total > 0) {
+            const uint32_t mainView = g_capRecords[total - 1].pad0;
+            // In-place compaction would clobber records we still need for the
+            // subview sweep, so partition via a scratch copy of the order.
+            static Rec scratch[kMaxRecordSlots];
+            static void* scratchImgs[kMaxRecordSlots][5];
+            memcpy(scratch, g_capRecords, total * sizeof(Rec));
+            memcpy(scratchImgs, g_capImagePtrs, total * sizeof(void*) * 5);
+            // debug isolation: r_wgpuSingleLight N keeps only the Nth light
+            // of THIS frame (g_capLightId grows monotonically across frames,
+            // so filter on the frame-relative id).
+            uint32_t frameMinLightId = 0xFFFFFFFFu;
+            if (g_capWgpuSingleLight >= 0) {
+                for (uint32_t i = 0; i < total; ++i) {
+                    if (scratch[i].pad0 != mainView) continue;
+                    if (scratch[i].lightId < frameMinLightId) frameMinLightId = scratch[i].lightId;
+                }
+            }
+            for (uint32_t i = 0; i < total; ++i) {
+                if (scratch[i].pad0 != mainView) continue;
+                if (g_capWgpuSingleLight >= 0) {
+                    const int rel = (int)(scratch[i].lightId - frameMinLightId);
+                    if (g_capWgpuSingleLight >= 1000) {
+                        // prefix mode: keep lights 0..(N-1000) — bisect tool
+                        if (rel > g_capWgpuSingleLight - 1000) continue;
+                    } else if (rel != g_capWgpuSingleLight) {
+                        continue;
+                    }
+                }
+                g_capRecords[n] = scratch[i];
+                memcpy(g_capImagePtrs[n], scratchImgs[i], sizeof(void*) * 5);
+                n++;
+            }
+            mainN = n;
+            // Iter 14: linked subview records follow, one slot range per link.
+            for (uint32_t L = 0; L < g_subviewLinkCount && L < kMaxSubviews; ++L) {
+                const uint32_t start = n;
+                for (uint32_t i = 0; i < total && n < kMaxRecordSlots; ++i) {
+                    if (scratch[i].pad0 != g_subviewLinks[L].viewTag) continue;
+                    if (scratch[i].pad0 == mainView) continue;
+                    g_capRecords[n] = scratch[i];
+                    memcpy(g_capImagePtrs[n], scratchImgs[i], sizeof(void*) * 5);
+                    n++;
+                }
+                subGroups[L].startSlot = start;
+                subGroups[L].count = n - start;
+                if (n > start) subGroupCount = L + 1;
+            }
+        }
+        // Per-slot uniform writes. r.modelMatrix holds the FULL MVP, baked
+        // at capture time in draw_arb2.cpp where this view's projection and
+        // this surface's modelView are both in scope. Use verbatim.
+        extern float g_capInvGamma;
+        for (uint32_t i = 0; i < n; ++i) {
+            const Rec& r = g_capRecords[i];
+            float ub[56];
+            memcpy(ub +  0, r.modelMatrix, 64);
+            memcpy(ub + 16, r.localLightOrigin, 16);
+            memcpy(ub + 20, r.localViewOrigin,  16);
+            memcpy(ub + 24, r.diffuseColor,     16);
+            memcpy(ub + 28, r.specularColor,    16);
+            memcpy(ub + 32, r.lightProjS,       16);
+            memcpy(ub + 36, r.lightProjT,       16);
+            memcpy(ub + 40, r.lightProjQ,       16);
+            memcpy(ub + 44, r.lightFalloffS,    16);
+            // Iter 8a params: ambient flag, vertex-color modulate/add
+            // (SVC_IGNORE=(0,1), SVC_MODULATE=(1,0), SVC_INVERSE=(-1,1)),
+            // brightness (pad3 is x1000 fixed-point), 1/gamma.
+            const float svcMod = (r.pad2 == 1u) ? 1.0f : (r.pad2 == 2u) ? -1.0f : 0.0f;
+            const float svcAdd = (r.pad2 == 1u) ? 0.0f : 1.0f;
+            ub[48] = (r.pad1 != 0u) ? 1.0f : 0.0f;
+            ub[49] = svcMod;
+            ub[50] = svcAdd;
+            ub[51] = (float)r.pad3 / 1000.0f;
+            ub[52] = g_capInvGamma;
+            ub[53] = g_capBfgSpec;   // iter 29: 1 = BFG pow(N·H,10) specular
+            // Iter 33: zeroClamp cookie flag — TR_CLAMP_TO_ZERO(3) /
+            // TR_CLAMP_TO_ZERO_ALPHA(4) projections must be ZERO outside
+            // their [0,1] uv box (no border-clamp samplers in WebGPU).
+            {
+                const ImgSlot* ps = D3_WebGPU_LookupCachedImage(g_capImagePtrs[i][2]);
+                ub[54] = (ps && (ps->repeat == 3 || ps->repeat == 4)) ? 1.0f : 0.0f;
+                // zeroClamp probe (single-light hunts only): name the cookie,
+                // its cached repeat mode, and the flag we just set.
+                if (g_capWgpuSingleLight >= 0) {
+                    static const void* probed[16] = {};
+                    static int probedN = 0;
+                    bool seen = false;
+                    for (int k = 0; k < probedN; ++k) if (probed[k] == g_capImagePtrs[i][2]) { seen = true; break; }
+                    if (!seen && probedN < 16) {
+                        probed[probedN++] = g_capImagePtrs[i][2];
+                        int cx = 0, e0 = 0, e1 = 0, e2 = 0, pw = 0, phh = 0;
+                        if (ps && ps->pixels) {
+                            pw = ps->w; phh = ps->h;
+                            const uint8_t* px = ps->pixels;
+                            const int mid = ((phh/2) * pw + pw/2) * 4;
+                            cx = px[mid];
+                            e0 = px[((phh/2) * pw + 1) * 4];            // left edge
+                            e1 = px[((phh/2) * pw + pw - 2) * 4];        // right edge
+                            e2 = px[(1 * pw + pw/2) * 4];                // top edge
+                        }
+                        EM_ASM_({
+                            console.info("[d3] zcProbe proj=" + UTF8ToString($0) +
+                                         " cached=" + $1 + " repeat=" + $2 + " zcFlag=" + $3 +
+                                         " size=" + $4 + "x" + $5 +
+                                         " centerR=" + $6 + " edgesR=(" + $7 + "," + $8 + "," + $9 + ")");
+                        }, D3_WebGPU_ImageName(g_capImagePtrs[i][2]),
+                           ps ? 1 : 0, ps ? ps->repeat : -1, (int)(ub[54]),
+                           pw, phh, cx, e0, e1, e2);
+                    }
+                }
+            }
+            // params2.w: falloff-coordinate-clamp disable (iter 71 debug A/B).
+            // Default 0 = clamp the axial falloff coord to [0,1] in the shader
+            // (the enpro orange-panel fix). r_wgpuSingleLight -871/-872 set it
+            // to 1 to reproduce the raw (unclamped) behavior; -870/-1 keep the
+            // fix on. Lets a Dawn run simulate the WebKit falloff-bleed.
+            ub[55] = (g_capWgpuSingleLight == -871 || g_capWgpuSingleLight == -872) ? 1.0f : 0.0f;
+            memcpy(recordUBStage + (size_t)i * kUBStride, ub, 224);
+            if (i + 1 > recordUBHigh) recordUBHigh = i + 1;
+            // Iter 7b: resolve the material bind group (creates GPU textures
+            // from the CPU image cache on first sight of each image).
+            // Iter 42: lastMatGroups holds its own reference — the cache may
+            // evict (and release) the entry while redraw-last frames still
+            // encode from this array; without the ref iOS threw
+            // "setBindGroup must be an instance of GPUBindGroup".
+            if (lastMatGroups[i]) wgpuBindGroupRelease(lastMatGroups[i]);
+            lastMatGroups[i] = getMaterialBindGroup(g_capImagePtrs[i]);
+            if (lastMatGroups[i]) wgpuBindGroupAddRef(lastMatGroups[i]);
+        }
+        // Keep a backend-local copy of the consumed records (the draw loop
+        // reads offsets/counts from here, and no-capture frames redraw it).
+        // lastRecordCount counts MAIN-view records only — the subview slot
+        // ranges (mainN..n) are drawn exclusively by their offscreen passes.
+        memcpy(lastRecords, g_capRecords, n * sizeof(Rec));
+        lastRecordCount = mainN;
+        outCount = mainN;
+        lastUploadedCapFrameId = g_capFrameId;
+
+        // Iter 13b: upload the sky cube-dir stream before the pass sweep.
+        {
+            extern uint8_t  g_skyDirsAccum[];
+            extern uint32_t g_skyDirBytes;
+            if (g_skyDirBytes > 0 && skyPipeline) {
+                const uint32_t need = (g_skyDirBytes + 3u) & ~3u;
+                if (need > skyDirCap) {
+                    if (skyDirBuf) wgpuBufferRelease(skyDirBuf);
+                    uint32_t cap = need; if (cap < 64*1024) cap = 64*1024;
+                    WGPUBufferDescriptor d = {};
+                    d.size = cap;
+                    d.usage = WGPUBufferUsage_Vertex | WGPUBufferUsage_CopyDst;
+                    skyDirBuf = wgpuDeviceCreateBuffer(device, &d);
+                    skyDirCap = cap;
+                }
+                if (skyDirBuf) wgpuQueueWriteBuffer(queue, skyDirBuf, 0, g_skyDirsAccum, need);
+            }
+            g_skyDirBytes = 0;
+        }
+
+        // Iter 17: upload this frame's decoded cinematic frames into the
+        // per-slot dynamic textures BEFORE the pass-record sweep builds
+        // bind groups against them, and retire last frame's transient
+        // groups (their submit has completed).
+        {
+            extern uint8_t  g_cinFrameBytes[][512 * 512 * 4];
+            extern int      g_cinFrameW[];
+            extern int      g_cinFrameH[];
