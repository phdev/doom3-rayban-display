+            uint32_t shadowedLightCount = 0;
+            bool tableOK = true;
+            for (uint32_t s = 0; s < lastShadowCount && tableOK; ++s) {
+                const uint32_t id = lastShadowRecords[s].lightId;
+                bool seen = false;
+                for (uint32_t k = 0; k < shadowedLightCount; ++k) {
+                    if (shadowedLights[k] == id) { seen = true; break; }
+                }
+                if (!seen) {
+                    if (shadowedLightCount >= 64) { tableOK = false; break; }
+                    shadowedLights[shadowedLightCount++] = id;
+                }
+            }
+            auto lightIsShadowed = [&](uint32_t id) -> bool {
+                if (!tableOK) return true;   // table overflow: mark/unmark every light (correct, just more volume draws)
+                for (uint32_t k = 0; k < shadowedLightCount; ++k) {
+                    if (shadowedLights[k] == id) return true;
+                }
+                return false;
+            };
+            WGPURenderPassColorAttachment ca = {};
+            ca.view = color;
+            ca.loadOp = WGPULoadOp_Clear;
+            ca.storeOp = WGPUStoreOp_Store;
+            ca.clearValue = { 0.0, 0.0, 0.0, 1.0 };
+            ca.depthSlice = WGPU_DEPTH_SLICE_UNDEFINED;
+            colorCleared = true;
