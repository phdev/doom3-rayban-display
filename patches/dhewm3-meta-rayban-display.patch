+                // in the scene blanket-darkened regions whose occluded light
+                // contributed nothing there (giant blobs). World/NPC shadows
+                // stay vanilla per-light; this pass exists so YOUR shadow is
+                // always visible.
+                for (uint32_t sIdx = 0; sIdx < lastShadowCount; ++sIdx) {
+                    const Rec& sr = lastShadowRecords[sIdx];
+                    if (!dbgStencilRef && sr.sPad3 != 1u) continue;   // dbg: ALL volumes
+                    wgpuRenderPassEncoderSetPipeline(rp, sr.pad1 ? shadowZPassPipeline : shadowZFailPipeline);
