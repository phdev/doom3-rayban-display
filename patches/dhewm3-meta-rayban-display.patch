+        // truncated scene reads as "truncated", not "covered".
+        if (g_capDropped) {
+            static uint32_t lastDropReport = 0;
+            if (detFrameCounter - lastDropReport > 600 || lastDropReport == 0) {
+                lastDropReport = detFrameCounter ? detFrameCounter : 1;
+                // Iter 81: per-cap breakdown so we know WHICH cap bit without
+                // guessing. Caps: pass/shadow record COUNT 32768, blend/fog 64,
+                // haze 16; the index (20MB) + vert (56MB) byte accumulators are
