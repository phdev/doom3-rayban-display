+                rpd.colorAttachmentCount = 1;
+                rpd.colorAttachments = &ca;
+                rpd.depthStencilAttachment = &da;
+                WGPURenderPassEncoder rp = wgpuCommandEncoderBeginRenderPass(enc, &rpd);
+                wgpuRenderPassEncoderSetStencilReference(rp, 128);
