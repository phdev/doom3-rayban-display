+    }
+
+    // ─── Iter 6.8: determinism self-test ────────────────────────────────────
+
+    // Encode the full record draw — depth pre-pass then additive lit pass —
+    // into the given color/depth views. Used by both the on-screen echo and
+    // the determinism self-test so the two stay structurally identical.
+    // colorTex (optional) is the texture behind `color` — needed as the copy
+    // source for the heat-haze _currentRender substitute. Pass null to skip
+    // haze (it then simply doesn't draw).
+    void encodeRecordsPass(WGPUCommandEncoder enc, WGPUTextureView color, WGPUTextureView depth,
+                           WGPUTexture colorTex = nullptr) {
+        // Iter 14: render linked subviews (mirrors/monitors) into their
+        // offscreen targets FIRST — the main view samples them.
+        for (uint32_t g = 0; g < subGroupCount; ++g) {
+            const SubGroup& sg = subGroups[g];
+            if (!sg.count || !interactionPipeline || !depthPipeline) continue;
+            if (!subviewTex[g]) {
+                WGPUTextureDescriptor td = {};
+                td.size = { 256, 256, 1 };
+                td.mipLevelCount = 1;
+                td.sampleCount = 1;
+                td.dimension = WGPUTextureDimension_2D;
+                td.format = surfaceFormat;
+                td.usage = WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_TextureBinding;
+                subviewTex[g] = wgpuDeviceCreateTexture(device, &td);
+                subviewView[g] = subviewTex[g] ? wgpuTextureCreateView(subviewTex[g], nullptr) : nullptr;
+                WGPUTextureDescriptor dd = td;
+                dd.format = WGPUTextureFormat_Depth24PlusStencil8;
+                dd.usage = WGPUTextureUsage_RenderAttachment;
+                subviewDepthTex[g] = wgpuDeviceCreateTexture(device, &dd);
+                subviewDepthView[g] = subviewDepthTex[g] ? wgpuTextureCreateView(subviewDepthTex[g], nullptr) : nullptr;
+            }
+            if (!subviewView[g] || !subviewDepthView[g]) continue;
