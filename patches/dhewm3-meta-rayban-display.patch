+                // frame — confirms the RB_T_FillDepthBuffer capture is active
+                // (non-zero) locally and on the live build.
+                static uint32_t dfPub = 0xFFFFFFFFu;
+                if (dfDrawn != dfPub) { dfPub = dfDrawn; EM_ASM_({ window.__d3DepthFillCount = $0; }, dfDrawn); }
+            }
+            wgpuRenderPassEncoderEnd(rp);
+            wgpuRenderPassEncoderRelease(rp);
+        }
+        // Iter 39: ONE lighting pass for everything. Per-light stencil
+        // isolation WITHOUT per-light passes: a shadowed light's volumes
+        // MARK the stencil, its interactions draw with GEQUAL-128, then the
+        // same volumes redraw with inverted ops to UNMARK — IncrementWrap
+        // and DecrementWrap are exact inverses (wraparound included), so the
+        // stencil returns to the cleared 128 for the next light. The iter-38
+        // structure (1 + shadowed-light-count passes) killed the iPhone at
+        // shdw 97: each pass costs a full-tile stencil clear/store on TBDR
+        // plus WebKit per-encoder allocations — the GPU helper process
+        // ballooned and jetsam killed the tab during boot. Volumes rasterize
+        // twice now; that is far cheaper than per-pass tile traffic.
+        bool colorCleared = false;
+        if (lastRecordCount > 0) {
+            uint32_t shadowedLights[64];
+            uint32_t shadowedLightCount = 0;
+            bool tableOK = true;
+            for (uint32_t s = 0; s < lastShadowCount && tableOK; ++s) {
+                const uint32_t id = lastShadowRecords[s].lightId;
+                bool seen = false;
+                for (uint32_t k = 0; k < shadowedLightCount; ++k) {
+                    if (shadowedLights[k] == id) { seen = true; break; }
+                }
+                if (!seen) {
+                    if (shadowedLightCount >= 64) { tableOK = false; break; }
+                    shadowedLights[shadowedLightCount++] = id;
+                }
+            }
+            auto lightIsShadowed = [&](uint32_t id) -> bool {
+                if (!tableOK) return true;   // table overflow: mark/unmark every light (correct, just more volume draws)
+                for (uint32_t k = 0; k < shadowedLightCount; ++k) {
+                    if (shadowedLights[k] == id) return true;
+                }
+                return false;
+            };
+            WGPURenderPassColorAttachment ca = {};
+            ca.view = color;
+            ca.loadOp = WGPULoadOp_Clear;
+            ca.storeOp = WGPUStoreOp_Store;
+            ca.clearValue = { 0.0, 0.0, 0.0, 1.0 };
+            ca.depthSlice = WGPU_DEPTH_SLICE_UNDEFINED;
+            colorCleared = true;
+            WGPURenderPassDepthStencilAttachment da = {};
+            da.view = depth;
+            da.depthLoadOp = kUsePrePass ? WGPULoadOp_Load : WGPULoadOp_Clear;
+            da.depthStoreOp = WGPUStoreOp_Store;
+            da.depthClearValue = 1.0f;
+            da.stencilLoadOp = WGPULoadOp_Clear;
+            da.stencilStoreOp = WGPUStoreOp_Store;
+            da.stencilClearValue = 128;
+            WGPURenderPassDescriptor rpd = {};
+            rpd.colorAttachmentCount = 1;
+            rpd.colorAttachments = &ca;
+            rpd.depthStencilAttachment = &da;
+            WGPURenderPassEncoder rp = wgpuCommandEncoderBeginRenderPass(enc, &rpd);
+            wgpuRenderPassEncoderSetStencilReference(rp, 128);
+            extern int g_capWgpuSingleLight;
+            // negative sentinels: stay clear of the >=0 single-light filter
+            WGPURenderPipeline dbgPipe =
+                (g_capWgpuSingleLight == -994) ? shadowDebugPipeline :
