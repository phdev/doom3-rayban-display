+    uint8_t                 passUBStage[kMaxRecordSlots * kUBStride] = {};
+    uint8_t                 shadowUBStage[kMaxRecordSlots * kUBStride] = {};
+    uint32_t                recordUBHigh = 0;   // slots used this drain (flush range)
+    uint32_t                passUBHigh = 0;
+    uint32_t                shadowUBHigh = 0;
