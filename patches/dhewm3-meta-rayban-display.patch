+                    wgpuQueueWriteBuffer(queue, hazeUniformBufs[hn], 0, ub, 128);
+                    lastHazeRecords[hn] = r;
+                    hn++;
+                }
+            }
+            lastHazeCount = hn;
+            g_hazeRecordCount = 0;
+            g_hazeVertBytes = 0;
+            g_hazeIndexBytes = 0;
+            if (hn > 0) {
+                static bool hazeAnnounced = false;
+                if (!hazeAnnounced) {
+                    hazeAnnounced = true;
+                    EM_ASM_({ console.info("[d3] WebGPU heat haze active: " + $0 + " surfaces"); }, hn);
+                }
+            }
+        }
+
+        // Iter 28: flush the slot-uniform stages — ONE writeBuffer per family
+        // (replaces the per-record writes; ~700 staging copies → ≤3).
+        if (recordUBHigh && recordUBuf)
