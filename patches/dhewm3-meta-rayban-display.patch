+                const uint32_t hTotal = (g_hazeRecordCount < 16u) ? g_hazeRecordCount : 16u;
+                for (uint32_t i = 0; i < hTotal && currentRenderView; ++i) {
+                    if (g_hazeRecords[i].pad0 != mainView) continue;
+                    const Rec& r = g_hazeRecords[i];
+                    if (!hazeUniformBufs[hn]) {
+                        WGPUBufferDescriptor d = {};
+                        d.size = 128;
+                        d.usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst;
+                        hazeUniformBufs[hn] = wgpuDeviceCreateBuffer(device, &d);
+                    }
+                    if (!hazeBindGroups[hn] ||
+                        hazeGroupImgs[hn][0] != g_hazeImagePtrs[i][0] ||
+                        hazeGroupImgs[hn][1] != g_hazeImagePtrs[i][1] ||
+                        hazeGroupGen[hn] != currentRenderGen) {
+                        if (hazeBindGroups[hn]) wgpuBindGroupRelease(hazeBindGroups[hn]);
+                        WGPUBindGroupEntry e[5] = {};
+                        e[0].binding = 0; e[0].buffer = hazeUniformBufs[hn]; e[0].size = 128;
+                        e[1].binding = 1; e[1].sampler = interactionMaterialSampler;
+                        e[2].binding = 2; e[2].textureView = currentRenderView;
+                        e[3].binding = 3; e[3].textureView = getEngineTextureView(g_hazeImagePtrs[i][0], fbFlatNormalView);
