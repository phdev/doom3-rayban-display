+            {
+                WGPURenderPassDepthStencilAttachment da = {};
+                da.view = subviewDepthView[g];
+                da.depthLoadOp = WGPULoadOp_Clear;
+                da.depthStoreOp = WGPUStoreOp_Store;
+                da.depthClearValue = 1.0f;
+                da.stencilLoadOp = WGPULoadOp_Clear;
+                da.stencilStoreOp = WGPUStoreOp_Store;
+                da.stencilClearValue = 128;
+                WGPURenderPassDescriptor rpd = {};
+                rpd.colorAttachmentCount = 0;
+                rpd.depthStencilAttachment = &da;
+                WGPURenderPassEncoder rp = wgpuCommandEncoderBeginRenderPass(enc, &rpd);
+                wgpuRenderPassEncoderSetPipeline(rp, depthPipeline);
+                for (uint32_t i = sg.startSlot; i < sg.startSlot + sg.count; ++i) {
+                    const Rec& r = lastRecords[i];
+                    if (r.sPad2) continue;   // translucent: no depth write
+                    wgpuRenderPassEncoderSetBindGroup(rp, 0, recordDepthBindGroups[i], 0, nullptr);
+                    wgpuRenderPassEncoderSetVertexBuffer(rp, 0, recordVertexBuf, r.vertOffset, (uint64_t)r.vertCount * 60u);
+                    wgpuRenderPassEncoderSetIndexBuffer(rp, recordIndexBuf, WGPUIndexFormat_Uint16, r.indexOffset, (uint64_t)r.indexCount * 2u);
+                    wgpuRenderPassEncoderDrawIndexed(rp, r.indexCount, 1, 0, 0, 0);
+                }
+                wgpuRenderPassEncoderEnd(rp);
+                wgpuRenderPassEncoderRelease(rp);
+            }
+            // additive lit
+            {
+                WGPURenderPassColorAttachment ca = {};
+                ca.view = subviewView[g];
+                ca.loadOp = WGPULoadOp_Clear;
+                ca.storeOp = WGPUStoreOp_Store;
+                ca.clearValue = { 0.0, 0.0, 0.0, 1.0 };
