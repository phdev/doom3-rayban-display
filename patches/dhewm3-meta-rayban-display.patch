+                wgpuRenderPassEncoderEnd(rp);
+                wgpuRenderPassEncoderRelease(rp);
+            }
+        }
+
+        // Iter 8b: pre-pass enabled — the depth pipeline now shares
+        // interaction.wgsl's vs_main, so clip-z is bit-identical between
+        // the z-fill and lit passes.
+        const bool kUsePrePass = true;
