+                e[1].binding = 1; e[1].sampler = interactionLightSampler;
+                e[2].binding = 2; e[2].textureView = fbWhiteView;
+                WGPUBindGroupDescriptor bgd = {};
+                bgd.layout = bloomBGL;
+                bgd.entryCount = 3;
+                bgd.entries = e;
