+            wgpuRenderPassEncoderEnd(rp);
+            wgpuRenderPassEncoderRelease(rp);
+        }
+        // Iter 23: Quest-style visible shadows — re-mark the union of ALL
+        // shadow volumes in a fresh stencil, then multiply every shadowed
+        // pixel by r_shadowDarken. Not physically per-light (vanilla only
+        // masks each light's own contribution) but it makes shadows READ
+        // the way they do on consoles/Quest, independent of light energy.
