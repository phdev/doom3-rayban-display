+    // every writeBuffer call with a staging copy — 2688 buffers + ~700 tiny
+    // writes/frame was the same per-call disease class as the WebKit GL
+    // blit storm. Slots write into a CPU stage; one writeBuffer per family
+    // per frame flushes the used range. Bind groups keep static offsets.
+    static constexpr uint32_t kUBStride = 256;
+    WGPUBuffer              recordUBuf = nullptr;
+    WGPUBuffer              passUBuf   = nullptr;
+    WGPUBuffer              shadowUBuf = nullptr;
