+            EM_ASM_({ console.info("[d3] WebGPU multi-surface upload: records=" + $0 + " vbytes=" + $1 + " ibytes=" + $2 + " texCache=" + $3); },
+                    n, vNeed, iNeed, texCacheCount);
+        }
