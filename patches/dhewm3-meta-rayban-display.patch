+#else
+        (void)x; (void)y; (void)width; (void)height;
+#endif
+    }
+
+    void SetStencilReference(uint32_t ref) override {
+#if D3_WEBGPU_AVAILABLE
+        if (!renderPass) return;
+        wgpuRenderPassEncoderSetStencilReference(renderPass, ref);
+#else
+        (void)ref;
+#endif
+    }
