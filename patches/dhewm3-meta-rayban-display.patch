+                uint32_t mvPrepass = lastRecordCount > 0
+                    ? lastRecords[lastRecordCount - 1].pad0 : 0u;
+                if (!mvPrepass) {
+                    // Scan back for the last 3D/depth-fill/sky/reflect record —
+                    // NOT 2D (lastPassRecords is ordered 3D-then-2D, so the bare
+                    // last entry is a HUD record from the GUI view).
+                    for (int i = (int)lastPassCount - 1; i >= 0; --i) {
+                        const uint32_t k = lastPassRecords[i].pad3;
+                        if (k == 0u || k == 4u || k == 2u || k == 3u) { mvPrepass = lastPassRecords[i].pad0; break; }
+                    }
+                }
+                // iter-81 pad3==0 (opaque material pass) + iter-120 pad3==4
+                // (RB_T_FillDepthBuffer no-stage walls) both fill prepass depth.
+                uint32_t dfDrawn = 0;
+                for (uint32_t i = 0; i < lastPassCount; ++i) {
+                    const Rec& r = lastPassRecords[i];
+                    // iter-125: the pad3==0 prepass depth-fill is OPAQUE-only (pad1==1),
+                    // mirroring GL's RB_T_FillDepthBuffer which returns early on
+                    // MC_TRANSLUCENT. iter-81 filled EVERY pad3==0 pass record (sPad2 is
+                    // never set on pass records), so an in-world monitor's ~8 stacked
+                    // COPLANAR TRANSLUCENT GUI fills (bgwhite4/adminbg/circle2/fonts, pad1==3)
+                    // each wrote near-identical prepass depth; in the color pass (LessEqual,
+                    // depthWrite off) per-fragment float jitter then made some quads fail the
+                    // depth test and drop out -> solid BLACK BLOCKS over the GUI content +
+                    // a z-fight HATCH over the teal. View-dependent; GL never does this.
+                    // pad3==4 (iter-120 no-stage walls) + opaque pad1==1 material passes
+                    // still fill depth, so the iter-81/120 sky-leak fix is preserved.
+                    if (!((r.pad3 == 0u && r.pad1 == 1u) || r.pad3 == 4u) || r.sPad2 || r.pad0 != mvPrepass) continue;
