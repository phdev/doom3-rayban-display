+extern "C" void D3_WebGPU_CacheCubeImage( const class idImage* img, const unsigned char* const pic[6], int size ) {
+	if ( !img || size <= 0 || size > 2048 ) return;
+	for ( int i = 0; i < 6; ++i ) if ( !pic[i] ) return;
+	int slot = -1;
+	for ( int i = 0; i < g_cubeCacheCount; ++i ) {
+		if ( g_cubeCache[i].ptr == (const void*)img ) { slot = i; break; }
+	}
+	if ( slot < 0 ) {
+		if ( g_cubeCacheCount >= 32 ) return;
+		slot = g_cubeCacheCount++;
+		g_cubeCache[slot].ptr = (const void*)img;
+		for ( int f = 0; f < 6; ++f ) g_cubeCache[slot].faces[f] = nullptr;
+	}
+	int step = 1;
+	while ( size / step > 128 ) step <<= 1;
+	const int ds = size / step;
+	for ( int f = 0; f < 6; ++f ) {
+		free( g_cubeCache[slot].faces[f] );
+		g_cubeCache[slot].faces[f] = (uint8_t*)malloc( (size_t)ds * ds * 4u );
+		if ( !g_cubeCache[slot].faces[f] ) { g_cubeCache[slot].ptr = nullptr; return; }
+		uint8_t* dst = g_cubeCache[slot].faces[f];
+		for ( int y = 0; y < ds; ++y ) {
+			const unsigned char* row = pic[f] + (size_t)(y * step) * size * 4u;
+			for ( int x = 0; x < ds; ++x ) {
+				const unsigned char* sp = row + (size_t)(x * step) * 4u;
+				*dst++ = sp[0]; *dst++ = sp[1]; *dst++ = sp[2]; *dst++ = sp[3];
+			}
+		}
+	}
+	g_cubeCache[slot].size = ds;
