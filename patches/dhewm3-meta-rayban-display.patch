+		flashlight.shaderParms[ SHADERPARM_RED ]		= 1.0f;
+		flashlight.shaderParms[ SHADERPARM_GREEN ]		= 1.0f;
+		flashlight.shaderParms[ SHADERPARM_BLUE ]		= 1.0f;
+		flashlight.shaderParms[ SHADERPARM_TIMESCALE ]	= 1.0f;
+		// Projection frustum from weapon_flashlight.def (light-local space).
+		flashlight.target	= idVec3(    0.0f,   0.0f, 1280.0f );
+		flashlight.up		= idVec3(    0.0f, 640.0f,    0.0f );
+		flashlight.right	= idVec3( -640.0f,   0.0f,    0.0f );
+		flashlight.end		= flashlight.target;
