+                EM_ASM_({ console.info("[d3] cap-drop " + $0 + " | pass=" + $1 + "/32768 shadow=" + $2 + " blend=" + $3 + "/64 fog=" + $4 + "/64 haze=" + $5 + "/16 | idxKB=" + $6 + "/20480 vertKB=" + $7 + "/57344"); },
