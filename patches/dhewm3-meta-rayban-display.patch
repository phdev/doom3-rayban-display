+                        bgd.entryCount = 5;
+                        bgd.entries = e;
+                        hazeBindGroups[hn] = wgpuDeviceCreateBindGroup(device, &bgd);
+                        hazeGroupImgs[hn][0] = g_hazeImagePtrs[i][0];
+                        hazeGroupImgs[hn][1] = g_hazeImagePtrs[i][1];
+                        hazeGroupGen[hn] = currentRenderGen;
+                    }
+                    float ub[32];
+                    memcpy(ub +  0, r.modelMatrix,     64);
+                    memcpy(ub + 16, r.localLightOrigin, 16);   // vertexParm 0: scroll
+                    memcpy(ub + 20, r.localViewOrigin,  16);   // vertexParm 1: magnitude
+                    {
+                        extern int g_capWgpuSingleLight;
+                        if (g_capWgpuSingleLight == -895) {
+                            extern uint8_t g_hazeVertsAccum[];
+                            const float* v = (const float*)(g_hazeVertsAccum + r.vertOffset);
+                            char hl[240];
+                            snprintf(hl, sizeof(hl),
+                                     "haze[%u] img=%s scroll=(%.2f,%.2f) mag=(%.2f,%.2f) m00=%.3f mask=%u nv=%u v0=(%.0f,%.0f,%.0f)",
+                                     hn, D3_WebGPU_ImageName(g_hazeImagePtrs[i][0]),
+                                     r.localLightOrigin[0], r.localLightOrigin[1],
+                                     r.localViewOrigin[0], r.localViewOrigin[1],
+                                     r.specularColor[0], r.pad1, r.vertCount, v[0], v[1], v[2]);
+                            EM_ASM_({ console.info("[d3] " + UTF8ToString($0)); }, hl);
+                        }
+                    }
+                    ub[24] = r.specularColor[0];               // projection m00
+                    ub[25] = (r.pad1 & 1u) ? 1.0f : 0.0f;      // hasMask
+                    ub[26] = (float)depthW;
+                    ub[27] = (float)depthH;
+                    ub[28] = (r.pad1 & 2u) ? 1.0f : 0.0f;      // mask *= vertex color
